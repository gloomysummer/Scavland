---
import Layout from '../../layouts/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';
import Countdown from '../../components/Countdown.astro';
import { allRuGuides } from '../../data/guides-ru';

const featured = allRuGuides.slice(0, 6);
---

<Layout title="Scavland Wiki на русском — Гайды, Оружие и Карта" description="Официальная база знаний Scavland на русском языке: подробные гайды по выживанию, оружие, обвесы, фракции, карта Залесья, дата выхода и системные требования." keywords="Scavland на русском, Scavland wiki ru, гайд Scavland, оружие Scavland, системные требования, карта Залесья, Steam Deck" canonical="/ru/" lang="ru">
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': 'https://scavland.wiki/ru/#website',
          name: 'Scavland Wiki (Русский)',
          url: 'https://scavland.wiki/ru/',
          description: 'Официальная база знаний и тактические руководства по Scavland на русском языке.',
          inLanguage: 'ru-RU',
          about: { '@id': 'https://scavland.wiki/#game' },
          potentialAction: {
            '@type': 'SearchAction',
            target: 'https://scavland.wiki/ru/search/?q={search_term_string}',
            'query-input': 'required name=search_term_string'
          }
        },
        {
          '@type': 'VideoGame',
          '@id': 'https://scavland.wiki/#game',
          name: 'Scavland',
          alternateName: ['Сковленд', 'Скавленд'],
          description: 'Хардкорная изометрическая RPG на выживание в декорациях советского постапокалипсиса.',
          url: 'https://store.steampowered.com/app/3373500/Scavland/',
          genre: ['Survival RPG', 'Extraction Shooter', 'Action RPG'],
          gamePlatform: ['PC (Windows)', 'Steam Deck'],
          datePublished: '2026-09-04',
          publisher: {
            '@type': 'Organization',
            name: 'NoShadow'
          },
          sameAs: [
            'https://store.steampowered.com/app/3373500/Scavland/',
            'https://steamcommunity.com/app/3373500'
          ]
        }
      ]
    })} />
  </Fragment>

  <section class="hero">
    <p class="eyebrow">База знаний сообщества · Версия раннего доступа</p>
    <h1>Scavland Вики</h1>
    <p class="lede">Полная база данных и тактическое руководство по Scavland — хардкорной изометрической RPG на выживание в декорациях советского постапокалипсиса. Исследуйте Залесье, зачищайте подземные бункеры, настраивайте 25+ видов оружия и выживайте в смертоносном Тумане.</p>
    
    <Countdown />

    <div class="hero-actions">
      <a class="button" href="/ru/guide/scavland-beginner-guide/">Гайд для новичков <span aria-hidden="true">➔</span></a>
      <a class="button secondary" href="/maps/">Карта Залесья и Бункеры ➔</a>
      <a class="button secondary" href="/weapons/">Арсенал оружия</a>
      <a class="button secondary" href="https://store.steampowered.com/app/3373500/Scavland/" target="_blank" rel="noopener noreferrer">Купить в Steam <span aria-hidden="true">↗</span></a>
    </div>

    <!-- 4-metric tactical authority cards -->
    <div class="hero-metrics-grid">
      <a class="metric-card" href="/weapons/">
        <span class="metric-value">25+</span>
        <span class="metric-label">Моделей оружия</span>
        <span class="metric-sub">Пистолеты, автоматы и СВД ➔</span>
      </a>
      <a class="metric-card" href="/weapons/">
        <span class="metric-value">300+</span>
        <span class="metric-label">Модификаций и обвесов</span>
        <span class="metric-sub">Оптика, глушители, цевья ➔</span>
      </a>
      <a class="metric-card" href="/factions/">
        <span class="metric-value">10</span>
        <span class="metric-label">Группировок Зоны</span>
        <span class="metric-sub">Уровни торговцев и репутация ➔</span>
      </a>
      <a class="metric-card" href="/release-date/">
        <span class="metric-value" style="color:var(--orange);">4 сен 2026</span>
        <span class="metric-label">Ранний доступ Steam</span>
        <span class="metric-sub">Патч v0.5.169 активен ➔</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Быстрый переход</p>
        <h2>Тактическая база Scavland</h2>
      </div>
      <p>Мгновенный доступ к проверенным фактам о релизе, системным требованиям, ценам в Steam и ключевым руководствам.</p>
    </div>
    <div class="card-grid" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:1rem;">
      <a class="guide-card" href="/ru/guide/scavland-vs-zero-sievert-comparison/" style="padding:1.25rem;display:block;text-decoration:none;border-radius:8px;border:1px solid var(--acid,#b9e86c);background:linear-gradient(135deg, rgba(185,232,108,0.06), #161616);">
        <span style="font-size:0.8rem;color:var(--acid,#b9e86c);font-weight:700;letter-spacing:1px;">★ ГЛАВНОЕ СРАВНЕНИЕ</span>
        <h3 style="margin:0.5rem 0;font-size:1.1rem;color:#fff;">Scavland против Zero Sievert</h3>
        <p style="font-size:0.85rem;color:var(--text-muted,#aaa);margin:0;">7 ключевых отличий: баллистика рикошетов, 300+ обвесов, механика Тумана и мультиплеер.</p>
      </a>
      <a class="guide-card" href="/ru/guide/scavland-beginner-guide/" style="padding:1.25rem;display:block;text-decoration:none;border-radius:8px;border:1px solid var(--border-color,#333);background:var(--card-bg,#161616);">
        <span style="font-size:0.8rem;color:var(--accent,#ffaa00);font-weight:700;letter-spacing:1px;">01 · ВЫЖИВАНИЕ</span>
        <h3 style="margin:0.5rem 0;font-size:1.1rem;color:#fff;">Гайд для новичков</h3>
        <p style="font-size:0.85rem;color:var(--text-muted,#aaa);margin:0;">Первый рейд, менеджмент рюкзака, костры и безопасный выход из локации.</p>
      </a>
      <a class="guide-card" href="/ru/guide/scavland-price-and-regional-editions/" style="padding:1.25rem;display:block;text-decoration:none;border-radius:8px;border:1px solid var(--border-color,#333);background:var(--card-bg,#161616);">
        <span style="font-size:0.8rem;color:var(--accent,#ffaa00);font-weight:700;letter-spacing:1px;">02 · СТОИМОСТЬ</span>
        <h3 style="margin:0.5rem 0;font-size:1.1rem;color:#fff;">Цена в Steam и скидки</h3>
        <p style="font-size:0.85rem;color:var(--text-muted,#aaa);margin:0;">Региональные цены в рублях и тенге, скидка 10% на старте и издания.</p>
      </a>
      <a class="guide-card" href="/ru/guide/scavland-steam-deck-and-handheld-settings/" style="padding:1.25rem;display:block;text-decoration:none;border-radius:8px;border:1px solid var(--border-color,#333);background:var(--card-bg,#161616);">
        <span style="font-size:0.8rem;color:var(--accent,#ffaa00);font-weight:700;letter-spacing:1px;">03 · ПОРТАТИВ</span>
        <h3 style="margin:0.5rem 0;font-size:1.1rem;color:#fff;">Scavland на Steam Deck</h3>
        <p style="font-size:0.85rem;color:var(--text-muted,#aaa);margin:0;">Настройки для стабильных 60 FPS при 9W TDP и 4+ часов работы от батареи.</p>
      </a>
      <a class="guide-card" href="/ru/guide/scavland-weapons-and-attachments/" style="padding:1.25rem;display:block;text-decoration:none;border-radius:8px;border:1px solid var(--border-color,#333);background:var(--card-bg,#161616);">
        <span style="font-size:0.8rem;color:var(--accent,#ffaa00);font-weight:700;letter-spacing:1px;">04 · АРСЕНАЛ</span>
        <h3 style="margin:0.5rem 0;font-size:1.1rem;color:#fff;">Оружие и модификации</h3>
        <p style="font-size:0.85rem;color:var(--text-muted,#aaa);margin:0;">Каталог 25+ стволов, 300+ обвесов, типы боеприпасов и ремонт оружия.</p>
      </a>
      <a class="guide-card" href="/ru/guide/scavland-factions-and-reputation/" style="padding:1.25rem;display:block;text-decoration:none;border-radius:8px;border:1px solid var(--border-color,#333);background:var(--card-bg,#161616);">
        <span style="font-size:0.8rem;color:var(--accent,#ffaa00);font-weight:700;letter-spacing:1px;">05 · ФРАКЦИИ</span>
        <h3 style="margin:0.5rem 0;font-size:1.1rem;color:#fff;">10 группировок Зоны</h3>
        <p style="font-size:0.85rem;color:var(--text-muted,#aaa);margin:0;">Репутация, контракты, тиры доверия торговцев и нейтральный рынок.</p>
      </a>
    </div>
  </section>

  <!-- Mirror of "Start here" section with exact .guide-grid styling -->
  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">С чего начать</p>
        <h2>Полевые руководства сталкера</h2>
      </div>
      <p>Каждая статья проверена в игре и отделяет официальные заявления разработчиков от тестов сообщества.</p>
    </div>
    <div class="guide-grid">
      {featured.map((guide, idx) => <GuideCard guide={guide} priority={idx < 2} lang="ru" />)}
    </div>
  </section>

  <!-- Mirror of "Critical Acclaim & Reception" section -->
  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Оценки и отзывы сообщества</p>
        <h2>Мнение профильных изданий и стримеров</h2>
      </div>
      <p>Независимые СМИ и ветераны выживалок делятся первыми впечатлениями об атмосфере, стрельбе и рейдах в Scavland.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:1.25rem;">
      <div style="padding:1.5rem;background:var(--panel,#121a16);border:1px solid var(--line,#27382b);border-radius:6px;display:flex;flex-direction:column;justify-content:space-between;">
        <blockquote style="margin:0 0 1rem;font-size:0.95rem;line-height:1.6;color:var(--ink,#dcdcdc);font-style:italic;">
          &ldquo;Scavland может стать лучшей инди-игрой 2026 года, если ранний доступ продолжит развиваться в том же духе. Атмосферный ретро-визуал, плотные квесты и модульная стрельба.&rdquo;
        </blockquote>
        <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(255,255,255,0.08);padding-top:0.75rem;">
          <span style="font-weight:700;color:var(--acid,#b9e86c);font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;">Insider Gaming</span>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:var(--muted,#888);">Обзор релиза</span>
        </div>
      </div>

      <div style="padding:1.5rem;background:var(--panel,#121a16);border:1px solid var(--line,#27382b);border-radius:6px;display:flex;flex-direction:column;justify-content:space-between;">
        <blockquote style="margin:0 0 1rem;font-size:0.95rem;line-height:1.6;color:var(--ink,#dcdcdc);font-style:italic;">
          &ldquo;Новая постапокалиптическая песочница, от которой невозможно оторваться! Превосходный саунд-дизайн, плавная пиксельная анимация и напряженный хаос пустошей.&rdquo;
        </blockquote>
        <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(255,255,255,0.08);padding-top:0.75rem;">
          <span style="font-weight:700;color:var(--acid,#b9e86c);font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;">Splattercatgaming</span>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:var(--muted,#888);">170K+ Просмотров</span>
        </div>
      </div>

      <div style="padding:1.5rem;background:var(--panel,#121a16);border:1px solid var(--line,#27382b);border-radius:6px;display:flex;flex-direction:column;justify-content:space-between;">
        <blockquote style="margin:0 0 1rem;font-size:0.95rem;line-height:1.6;color:var(--ink,#dcdcdc);font-style:italic;">
          &ldquo;Scavland — мрачный тактический RPG-сурвайвал, заслуживающий внимания. Жесткие боевые столкновения и высокая цена ошибки делают каждый рейд незабываемым.&rdquo;
        </blockquote>
        <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(255,255,255,0.08);padding-top:0.75rem;">
          <span style="font-weight:700;color:var(--acid,#b9e86c);font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;">AddictingGames</span>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:var(--muted,#888);">Первый взгляд</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Mirror of "The evidence desk" section -->
  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">База фактов</p>
        <h2>Смотри, прежде чем рисковать</h2>
      </div>
      <p>Официальные скриншоты в 1080p и записи геймплея служат надежным источником данных для планирования каждого выхода в Зону.</p>
    </div>
    <div class="media-strip">
      <img src="/images/screenshots/steam_ss_08.webp" alt="Официальная карта секторов Залесья в Scavland" loading="lazy" decoding="async" width="400" height="170" />
      <img src="/images/screenshots/steam_ss_05.webp" alt="Интерфейс инвентаря и осмотра предметов в Scavland" loading="lazy" decoding="async" width="400" height="170" />
      <img src="/images/screenshots/steam_ss_09.webp" alt="Детекция аномалий и радиации в Scavland" loading="lazy" decoding="async" width="400" height="170" />
    </div>
    <p class="caption">Источник материалов: Официальный магазин Steam Store (1080p) · Уровень подтверждения: Официальная верифицированная база данных.</p>
  </section>

  <!-- Mirror of "Community Notice" section -->
  <section class="section" id="codes">
    <div class="note" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1.5rem;background:var(--card-bg,#161616);border:1px solid var(--border-color,#333);padding:1.5rem;border-radius:8px;">
      <div>
        <span style="font-size:0.75rem;text-transform:uppercase;color:var(--accent,#ffaa00);font-weight:700;letter-spacing:1px;">Важное уведомление</span>
        <h3 style="margin:0.35rem 0 0.5rem 0;color:#fff;">Статус промокодов и чит-кодов в Scavland</h3>
        <p style="color:var(--text-muted,#aaa);font-size:0.95rem;margin:0;">В текущей версии раннего доступа в Scavland <strong>полностью отсутствуют официальные промокоды или консольные команды</strong>. Любые сторонние сайты, предлагающие секретные коды или генераторы предметов — не верифицированы. Мы отслеживаем все официальные анонсы разработчиков и сразу опубликуем их здесь.</p>
      </div>
      <div style="display:flex;gap:0.75rem;">
        <a class="button" href="/ru/guide/" style="font-size:0.85rem;padding:0.4rem 0.8rem;">Все гайды →</a>
        <a class="button secondary" href="/updates/" style="font-size:0.85rem;padding:0.4rem 0.8rem;">История патчей →</a>
      </div>
    </div>
  </section>

  <!-- Mirror of "The game - What is Scavland?" section -->
  <section class="section about-home">
    <div class="section-head">
      <div>
        <p class="eyebrow">Об игре</p>
        <h2>Что такое Scavland?</h2>
      </div>
    </div>
    <div class="prose">
      <p>Scavland — это хардкорный изометрический пиксель-арт RPG-сурвайвал, действие которого разворачивается в Залесье — регионе, опустошенном войной и загадочным Туманом. Вы играете за Стервятника (Vulture) — вольного сталкера, который выживает, исследуя опасные сектора, собирая ценные припасы, выполняя контракты и сражаясь с мутантами и враждебными выжившими.</p>
      <p>Успех зависит от тактической подготовки, выверенной стрельбы, контроля веса рюкзака, торговли и умения вовремя отступить. Проработанный открытый мир включает заброшенные поселения, советские бункеры, леса, радиоактивные болота, 10 фракций, квесты и смертоносные подземные лаборатории.</p>
    </div>
    <div class="hero-actions">
      <a class="button" href="/ru/guide/">Смотреть все гайды</a>
    </div>
  </section>

  <!-- Mirror of "Final CTA" section -->
  <section class="section final-cta">
    <div class="section-head">
      <div>
        <p class="eyebrow">Твой следующий рейд</p>
        <h2>Готовы покорить Залесье?</h2>
      </div>
      <p>От первого выхода за забор лагеря до штурма укрепленных бункеров, фракционных войн и тайн Тумана — держите базу Scavland Wiki под рукой.</p>
    </div>
    <div class="hero-actions">
      <a class="button" href="/ru/guide/scavland-beginner-guide/">Читать гайд для новичков</a>
      <a class="button secondary" href="https://store.steampowered.com/app/3373500/Scavland/" rel="noreferrer">Купить в Steam</a>
    </div>
  </section>
</Layout>
