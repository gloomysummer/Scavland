---
import Layout from '../../layouts/Layout.astro';

const faqs = [
  {
    category: 'Release & Platforms',
    question: 'When is the Scavland Early Access release date?',
    answer: 'Scavland officially launches into Steam Early Access on September 4, 2026. The initial release features the full Act I territory of the Zalesye wasteland, procedural bunkers, 10 factions, and over 25 weapons.'
  },
  {
    category: 'Release & Platforms',
    question: 'Can I play Scavland on Steam Deck or with a controller?',
    answer: 'Yes. Scavland is verified for 60 FPS performance on Steam Deck with native twin-stick controller mapping, customizable UI text scaling for 7-inch/8-inch screens, and full gamepad support alongside traditional mouse/keyboard controls.'
  },
  {
    category: 'Gameplay & Mechanics',
    question: 'How do weapon jams work and how do I clear a misfire in combat?',
    answer: 'Weapons with durability below 50% have a progressive chance to jam during automatic or rapid fire. If your gun jams, double-tap the reload key [R] or manually cycle the bolt to eject the stuck cartridge and chamber a fresh round. Apply Gun Cleaning Oil or visit a safehouse workbench to restore durability above 70% for zero jam risk.'
  },
  {
    category: 'Gameplay & Mechanics',
    question: 'How do you survive the toxic Mist and farm rare artifacts?',
    answer: 'Entering the Mist requires a Gas Mask with active filter charge and Anti-Rad medicine. Equip the handheld Anomaly Scanner on hotkey [3] and listen to the audio ping frequency—the faster and higher-pitched the beeping, the closer you are to a high-tier artifact spawned within the anomaly field.'
  },
  {
    category: 'Gameplay & Mechanics',
    question: 'Is Scavland a rogue-lite or permadeath game?',
    answer: 'No. Scavland is a persistent top-down survival RPG with persistent stash and quest progression. While dying in the wasteland drops your equipped backpack at the spot of defeat, you do not lose your base storage or character progress, and you can mount a recovery run to retrieve your dropped backpack.'
  },
  {
    category: 'Gameplay & Mechanics',
    question: 'What happens when you die in Scavland?',
    answer: 'When you die, your active backpack drops at that exact world coordinate as a retrievable container. You respawn safely in your base hub, where you can gear up with secondary fallback items and travel back to retrieve your lost loot.'
  },
  {
    category: 'Equipment & Economy',
    question: 'Which junk items are most valuable to keep for traders?',
    answer: 'Not all junk is equal. Settlement merchants pay significantly higher barter prices for functional industrial parts such as spark plugs, lighters, toolboxes, electrical relays, and medical supplies compared to common scrap.'
  },
  {
    category: 'Equipment & Economy',
    question: 'What are the best starter weapons for a new player?',
    answer: 'For your first runs, the Makarov PM (low weight backup), TOZ-34 shotgun (instant mutant knockdown in tight corridors), and standard AK-74M provide the most dependable balance of cheap ammunition availability and stopping power.'
  },
  {
    category: 'Equipment & Economy',
    question: 'Will there be weapon modding and ammo unloading?',
    answer: 'Yes. The full game features 25+ base firearms and over 300 attachments. Developer Lucasmml confirmed dedicated weapon modding stations, item repairs, and stack-aware vertical ammo unloading are actively in the development roadmap.'
  },
  {
    category: 'Factions & Quests',
    question: 'Can faction choices lock me out of certain merchants?',
    answer: 'Yes. Zalesye features 10 dynamic factions. Raising reputation with military Bunker Wardens or Scientists unlocks high-tier armor and optical scopes, but attacking their patrols or doing rival contracts can turn them permanently hostile.'
  },
  {
    category: 'Community & Codes',
    question: 'Are there any official Scavland promo codes or cheat commands?',
    answer: 'No official cheat codes or promo gift codes exist for the Early Access launch. Any third-party sites advertising code generators or free item unlockers are unverified.'
  }
];

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(faq => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.answer
    }
  }))
};
---
<Layout 
  title="Scavland FAQ: Release Date, Gameplay Mechanics, Scanner & Loot" 
  description="Comprehensive answers to top community questions for Scavland: Early Access release date, Anomaly Scanner usage, death mechanics, trader items, weapon modding, and mod support." 
  canonical="/faq/"
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </Fragment>

  <section class="listing">
    <p class="eyebrow">Evidence-based answers</p>
    <h1 class="page-title">Frequently Asked Questions<span style="color:var(--acid)">.</span></h1>
    <p class="lede" style="max-width:720px;margin-bottom:2.5rem;color:var(--muted)">
      Everything you need to know about Scavland's September 4, 2026 Early Access launch, core survival mechanics, developer-confirmed systems, and wasteland extraction.
    </p>

    <div class="prose faq-list">
      {faqs.map((faq, index) => (
        <details open={index < 4} style="margin-bottom:1.25rem;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.02);border-radius:6px;padding:1rem 1.25rem;">
          <summary style="cursor:pointer;font-weight:600;font-size:1.1rem;color:var(--heading,#fff);list-style:none;display:flex;justify-content:space-between;align-items:center;">
            <span>{faq.question}</span>
            <span style="font-size:0.75rem;padding:0.2rem 0.5rem;border-radius:4px;background:rgba(218,255,125,0.1);color:var(--acid,#daff7d);font-family:var(--font-mono,monospace);">{faq.category}</span>
          </summary>
          <p style="margin-top:0.75rem;margin-bottom:0;color:var(--text-muted,#c5c5c5);line-height:1.6;">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>

    <div style="margin-top:3rem;padding:1.5rem;border-left:3px solid var(--acid,#daff7d);background:rgba(218,255,125,0.05);border-radius:0 6px 6px 0;">
      <h3 style="margin-top:0;font-size:1.1rem;">Have a question not listed here?</h3>
      <p style="margin-bottom:0.75rem;color:var(--text-muted,#bbb);">
        Check out our comprehensive field guides for in-depth breakdowns on weapons, maps, factions, and survival routes.
      </p>
      <a class="button" href="/guide/">Browse All Field Guides <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>
