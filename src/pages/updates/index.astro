---
import Layout from '../../layouts/Layout.astro';

const timeline = [
  {
    date: 'September 16, 2026',
    tag: 'Official Hotfix (0.7.1)',
    title: 'Hotfix 0.7.1: Stash Interaction Fix',
    summary: 'A swift follow-up hotfix addressing player stash accessibility after Update 0.7.0.',
    details: [
      'Fixed stash not opening for some players upon interacting with storage containers in settlements.',
      'Released following Update 0.7.0 to guarantee persistent inventory access across all safehouses and camps.'
    ]
  },
  {
    date: 'September 16, 2026',
    tag: 'Official Update (0.7.0)',
    title: 'Update 0.7.0: Stash Expansions, Rebuilt Death Screen & Combat Rebalance',
    summary: 'Another substantial update: stash expansions, a rebuilt Death Screen, and major passes across weapon durability, accuracy, stamina, Traders, Jobs, AI and the world.',
    details: [
      'Stash expansions: buy one from a Trader for 50,000 Rubles to unlock an extra Stash tab. Stashes and crafting tables were added to all main camps, but for now only the main village has upgradable stashes.',
      'Traders now pay an additional 5% sell value per Trader Rank.',
      'Death Screen rebuilt with real actions instead of any-key: Returner gets Continue / Load Game, Iron Man gets New Game / Exit, Tutorial gets Try Again, with full gamepad support.',
      "Each run now has its own Autosave Slot, protecting the save you're currently playing.",
      'Weapon durability and repairs reworked: weapons last significantly longer, jams are less punishing, and a large part of the arsenal gained accuracy, range, durability and damage improvements.',
      'Also added: Green Rags in the starter kit, and a 30-round magazine for the Thread Cutter. Existing saves stay compatible, but the developer recommends starting a new game.'
    ]
  },
  {
    date: 'September 10, 2026',
    tag: 'Official Hotfix (0.6.3)',
    title: 'Hotfix 0.6.3: NPC Interaction Fix',
    summary: 'A second same-day hotfix cleared an interaction blocker introduced by the new sleep system.',
    details: [
      'Fixed not being able to interact with the Zoran NPC because of the bed-sleep interaction.',
      'Superseded by Update 0.7.0 on 2026-09-16. Source: the official Steam announcement feed.'
    ]
  },
  {
    date: 'September 10, 2026',
    tag: 'Official Hotfix (0.6.2)',
    title: 'Hotfix 0.6.2: Sleep Healing & Leon 1895 Damage Buff',
    summary: 'The first post-0.6.0 hotfix made sleeping restorative and raised the damage of the Leon 1895 family.',
    details: [
      'Leon 1895 (short, standard and long) does +50% projectile damage.',
      'Sleeping now restores 5 health per in-game hour.',
      "Torch and barrel lighting pass, a Tarja's house fix, and missing trees added.",
      'Gamepad cancel-job confirmation now moves between No and Yes; notification toasts no longer spawn in the wrong place.'
    ]
  },
  {
    date: 'September 9, 2026',
    tag: 'Official Update (0.6.0)',
    title: 'Update 0.6.0: Sleeping, Rebuilt Controls, Jobs Overhaul & Trader Rebalance',
    summary: 'The largest patch of the Early Access period so far.',
    details: [
      'Sleeping added: rest in beds to skip time while the world keeps running. The sleep screen previews how your stats will change, saving is disabled during sleep, and taking damage wakes you.',
      'Controls & Keybinding rebuilt: the Controls page is split into Movement, Combat, Inventory, Crafting, Trader, Map, Journal and General, with hold/tap combinations and a new context-sensitive Action Hint Bar.',
      "Jobs & Journal overhaul: track multiple jobs, cancel from the Journal (a cancelled job costs 20% of its reputation reward, minimum 1), partial item turn-ins, and Quest vs Job items shown in different colours.",
      'Traders & economy rebalance: traders specialise more — Zhivan pays 140% for Common items, Vesna 75%, Nadja 90% for Common and 80% for Crafting, Grigory has dropped Medical/Food/Crafting but pays more for weapon attachments, Volodymyr sells far more attachments and offers the Advanced Weapon Repair Kit recipe at Rank 2, and Bogdan pays 40% more for Mutant Parts.',
      'Weapons, items and armour: weapon range up by +1 or +2 across the board, MK-47 reclassified as Basic tier, armour durability rebalanced (Tattered 4 to 3, Scavenger 5 to 4, Medium 6 to 5, Heavy 7 to 6), IFAK stacking raised to 3.',
      'Simplified Chinese added as an early, non-final localisation so the Chinese community can play in their own language ahead of the official translation.'
    ]
  },
  {
    date: 'September 5, 2026',
    tag: 'Official Update (0.5.169) — Day One Patch',
    title: 'Day One Patch 0.5.169: Explorer Mode, Campfire Healing & a Wider Stash',
    summary: 'The Day One patch landed the day after launch, responding to feedback from the first 24 hours.',
    details: [
      'Explorer game mode added. Maximum Stamina is 150 in Explorer and 100 in Returner and Iron Man.',
      'Campfire healing, a much bigger Stash, doubled Stamina, and new medical blueprints.',
      'A broad balance pass across survival, traders, armour, items and mutants.',
      'The developer apologised that Simplified Chinese had been listed as supported at release; that listing was removed until the official localisation is ready, with a community-made unofficial translation available in the meantime.'
    ]
  },
  {
    date: 'September 4, 2026',
    tag: 'Steam Early Access Launch',
    title: 'Scavland Launches into Early Access',
    summary: 'After six years of development Scavland launched into Steam Early Access, with more than 230,000 wishlists behind it.',
    details: [
      'The developer thanked the community, noting the project grew from a small team effort into something far bigger than anyone imagined.',
      'A launch-day livestream ran with the game designer.',
      'Early Access was framed as "only the beginning", with in-game bug report, suggestion and balance feedback buttons.'
    ]
  },
  {
    date: 'August 25, 2026',
    tag: 'Milestone',
    title: '100,000 Steam Wishlists',
    summary: 'Scavland passed 100,000 wishlists ahead of the September 4 launch date.',
    details: [
      'The developer described the game as a six-year journey.',
      'The team had grown from 3 developers to around 15 over the past year.',
      'The world is now roughly 3x larger, with new settlements, roads, faction territories and a complete visual overhaul.',
      'Procedurally generated underground bunkers were added, bringing a different kind of exploration below the surface.'
    ]
  },
  {
    date: 'June 9, 2025',
    tag: 'Official Demo Build (v0.2.4.1)',
    title: 'Scavland Demo Goes Live (v0.2.4.1)',
    summary: 'The public demo build was released alongside a v0.2.4.1 changelog on the Steam news feed.',
    details: [
      'This is the last pre-release build documented on the official Steam announcement feed.',
      'The public patch history above resumes with the September 2026 Early Access launch.'
    ]
  }
];
---
<Layout 
  title="Scavland Updates & Release Timeline — Scavland Wiki" 
  description="Verified timeline of Scavland announcements, developer patch notes, Early Access changelogs, and roadmap milestones." 
  canonical="/updates/"
>
  <section class="listing">
    <p class="eyebrow">Release watch &amp; verification log</p>
    <h1 class="page-title">Scavland Updates &amp;<br/><span style="color:var(--acid)">Release Timeline.</span></h1>
    <p class="lede" style="max-width:720px;margin-bottom:2.5rem;color:var(--muted)">
      Every claim on Scavland Field Notes is traced to a dated official Steam announcement or an explicitly-labelled community report.
    </p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));gap:1rem;margin-bottom:3rem;">
      <div style="padding:1.25rem;background:rgba(218,255,125,0.05);border:1px solid rgba(218,255,125,0.2);border-radius:8px;">
        <span style="font-size:0.8rem;color:var(--acid);font-family:var(--font-mono,monospace);text-transform:uppercase;">Early Access Live</span>
        <h3 style="margin:0.25rem 0 0.5rem;font-size:1.4rem;">Sept 4, 2026</h3>
        <p style="margin:0;font-size:0.9rem;color:var(--text-muted,#aaa);">Steam Early Access · Act I</p>
      </div>
      <div style="padding:1.25rem;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:8px;">
        <span style="font-size:0.8rem;color:var(--text-muted);font-family:var(--font-mono,monospace);text-transform:uppercase;">Community Scale</span>
        <h3 style="margin:0.25rem 0 0.5rem;font-size:1.4rem;color:var(--acid);">230K+</h3>
        <p style="margin:0;font-size:0.9rem;color:var(--text-muted,#aaa);">Global Steam Wishlists</p>
      </div>
      <div style="padding:1.25rem;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:8px;">
        <span style="font-size:0.8rem;color:var(--text-muted);font-family:var(--font-mono,monospace);text-transform:uppercase;">Launch Scope</span>
        <h3 style="margin:0.25rem 0 0.5rem;font-size:1.4rem;">25+ Guns</h3>
        <p style="margin:0;font-size:0.9rem;color:var(--text-muted,#aaa);">Attachment-heavy gunsmithing</p>
      </div>
    </div>

    <h2 style="font-size:1.5rem;margin-bottom:1.5rem;">Timeline of Official Statements &amp; Verified Changes</h2>
    
    <div style="position:relative;border-left:2px solid rgba(255,255,255,0.1);padding-left:1.5rem;margin-left:0.5rem;">
      {timeline.map((item) => (
        <div style="position:relative;margin-bottom:2.5rem;">
          <div style="position:absolute;left:-1.95rem;top:0.25rem;width:12px;height:12px;border-radius:50%;background:var(--acid,#daff7d);box-shadow:0 0 8px var(--acid,#daff7d);"></div>
          <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.4rem;">
            <span style="font-family:var(--font-mono,monospace);font-size:0.85rem;color:var(--text-muted);">{item.date}</span>
            <span style="font-size:0.7rem;padding:0.15rem 0.45rem;border-radius:3px;background:rgba(255,255,255,0.08);color:#fff;font-weight:600;">{item.tag}</span>
          </div>
          <h3 style="margin:0 0 0.5rem;font-size:1.2rem;color:var(--heading,#fff);">{item.title}</h3>
          <p style="margin:0 0 0.75rem;color:var(--text-muted,#bbb);line-height:1.5;">{item.summary}</p>
          <ul style="margin:0 0 1rem 0;padding-left:1.25rem;color:var(--text-muted,#aaa);font-size:0.95rem;line-height:1.6;">
            {item.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
          {item.date === 'September 5, 2026' && (
            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:0.75rem;margin-top:0.75rem;">
              <figure style="margin:0;">
                <img src="/images/screenshots/steam_ss_09.webp" alt="In-game radioactive anomaly scan test" style="width:100%;height:140px;object-fit:cover;border-radius:4px;border:1px solid rgba(255,255,255,0.1);" loading="lazy" />
                <figcaption style="font-size:0.75rem;color:var(--text-muted,#888);margin-top:0.3rem;">Anomaly scanner sweep &amp; artifact extraction</figcaption>
              </figure>
              <figure style="margin:0;">
                <img src="/images/screenshots/steam_ss_05.webp" alt="In-game inventory grid and ammo management" style="width:100%;height:140px;object-fit:cover;border-radius:4px;border:1px solid rgba(255,255,255,0.1);" loading="lazy" />
                <figcaption style="font-size:0.75rem;color:var(--text-muted,#888);margin-top:0.3rem;">Inventory stacking &amp; ammo unloading preview</figcaption>
              </figure>
              <figure style="margin:0;">
                <img src="/images/community/yt_dropin_letsplay.webp" alt="Dropin community gameplay demonstration" style="width:100%;height:140px;object-fit:cover;border-radius:4px;border:1px solid rgba(255,255,255,0.1);" loading="lazy" />
                <figcaption style="font-size:0.75rem;color:var(--text-muted,#888);margin-top:0.3rem;">Community test: trader junk value &amp; barter</figcaption>
              </figure>
            </div>
          )}
          {item.date === 'September 4, 2026' && (
            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:0.75rem;margin-top:0.75rem;">
              <figure style="margin:0;">
                <img src="/images/screenshots/steam_ss_08.webp" alt="Zalesye overworld map layout" style="width:100%;height:140px;object-fit:cover;border-radius:4px;border:1px solid rgba(255,255,255,0.1);" loading="lazy" />
                <figcaption style="font-size:0.75rem;color:var(--text-muted,#888);margin-top:0.3rem;">Official overworld zone map (Act I)</figcaption>
              </figure>
              <figure style="margin:0;">
                <img src="/images/screenshots/steam_ss_01.webp" alt="Tactical ruin exploration at night" style="width:100%;height:140px;object-fit:cover;border-radius:4px;border:1px solid rgba(255,255,255,0.1);" loading="lazy" />
                <figcaption style="font-size:0.75rem;color:var(--text-muted,#888);margin-top:0.3rem;">Night scavenging &amp; tactical combat</figcaption>
              </figure>
            </div>
          )}
        </div>
      ))}
    </div>

    <div style="margin-top:2rem;padding:1.25rem;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.08);border-radius:6px;">
      <h3 style="margin-top:0;font-size:1.05rem;">How we update this site</h3>
      <p style="margin-bottom:0;color:var(--text-muted);font-size:0.9rem;">
        Patch entries on this page are transcribed from the official Steam announcement feed for Scavland. Where a detail is not stated in an official post we either omit it or label it as a community report; we do not publish weapon damage tables, trader prices or spawn coordinates that we have not sourced.
      </p>
    </div>
  </section>
</Layout>
