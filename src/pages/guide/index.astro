---
import Layout from '../../layouts/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { guides } from '../../data/guides';
---

<Layout title="Scavland Guides & Scav Land Walkthroughs | Scavland Wiki" description="Browse verified Scavland (Scav Land) survival guides: beginner tips, cheats & console commands, weapons, repair, crafting, cooking, multiplayer, and extraction mechanics." canonical="/guide/" keywords="Scavland guides, Scav Land guide, Scavland walkthrough, Scavland cheats, Scavland beginner guide, Scavland survival tips, scavland how to cook, scavland multiplayer">
  <section class="listing">
    <p class="eyebrow">Primary index</p>
    <h1 class="page-title">All<br/><span style="color:var(--acid)">guides.</span></h1>
    <p class="lede">Start with the learning path, then move into systems and locations as your runs become more ambitious.</p>
    <div class="quick-jump-bar" style="margin: 20px 0 28px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center;">
      <span style="font-family: 'IBM Plex Mono', monospace; font-size: 0.75rem; color: var(--muted); text-transform: uppercase;">Direct Briefings:</span>
      <a href="/guide/scavland-developer-commitments-and-patch-roadmap/" style="font-size: 0.8rem; padding: 6px 12px; border: 1px solid var(--line); border-radius: 3px; background: rgba(255,255,255,0.03); color: var(--acid);">Roadmap & scavland.com</a>
      <a href="/guide/scavland-coop-and-multiplayer-mechanics/" style="font-size: 0.8rem; padding: 6px 12px; border: 1px solid var(--line); border-radius: 3px; background: rgba(255,255,255,0.03); color: var(--ink);">Co-op & Multiplayer</a>
      <a href="/guide/scavland-crafting-and-trading/" style="font-size: 0.8rem; padding: 6px 12px; border: 1px solid var(--line); border-radius: 3px; background: rgba(255,255,255,0.03); color: var(--ink);">Cooking & Crafting</a>
      <a href="/guide/scavland-merchant-prices-and-barter-guide/" style="font-size: 0.8rem; padding: 6px 12px; border: 1px solid var(--line); border-radius: 3px; background: rgba(255,255,255,0.03); color: var(--ink);">Trader Volodymyr & Barter</a>
      <a href="/guide/scavland-hospital-quest-and-medical-supplies/" style="font-size: 0.8rem; padding: 6px 12px; border: 1px solid var(--line); border-radius: 3px; background: rgba(255,255,255,0.03); color: var(--ink);">Hospital Quest & Meds</a>
      <a href="/guide/scavland-anomaly-scanner-and-artifacts/" style="font-size: 0.8rem; padding: 6px 12px; border: 1px solid var(--line); border-radius: 3px; background: rgba(255,255,255,0.03); color: var(--ink);">Core Detector & Artifacts</a>
    </div>
    <!-- Distinct format from the 300x250 below: Adsterra de-duplicates impressions for the same
         placement key within a pageview, so a second 300x250 would earn nothing.
         Placed above the grid (not next to the 300x250 at the bottom) for real viewability. -->
    <AdSlot slot="banner-728x90" label="Sponsored Field Resources" />
    <div class="listing-grid">
      {guides.map((guide) => <GuideCard guide={guide} />)}
    </div>
    <AdSlot slot="banner300x250" label="Recommended Field Resources" />
  </section>
</Layout>
