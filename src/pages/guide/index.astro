---
import Layout from '../../layouts/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { guides } from '../../data/guides';
---
<Layout title="Scavland Guides & Scav Land Walkthroughs | Scavland Wiki" description="Browse verified Scavland (Scav Land) survival guides: beginner tips, cheats & console commands, weapons, repair, crafting, and extraction mechanics." canonical="/guide/" keywords="Scavland guides, Scav Land guide, Scavland walkthrough, Scavland cheats, Scavland beginner guide, Scavland survival tips"><section class="listing"><p class="eyebrow">Primary index</p><h1 class="page-title">All<br/><span style="color:var(--acid)">guides.</span></h1><p class="lede">Start with the learning path, then move into systems and locations as your runs become more ambitious.</p><div class="listing-grid">{guides.map((guide) => <GuideCard guide={guide} />)}</div></section></Layout>
