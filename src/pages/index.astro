---
import Layout from '../layouts/Layout.astro';
import GuideCard from '../components/GuideCard.astro';
import Countdown from '../components/Countdown.astro';
import { guides } from '../data/guides';
const featured = guides.slice(0, 6);
---
<Layout title="Scavland Wiki (Scav Land) — Guides, Weapons, Maps, Cheats & Systems" description="The definitive Scavland Wiki (Scav Land Guide): comprehensive survival guides, cheats & console commands, weapons, attachments, factions, maps, and extraction mechanics for Zalesye." keywords="Scavland Wiki, Scavland, Scav Land, Scav Land guide, scav land wiki, Scavland cheats, Scavland beginner guide, survival RPG, weapons, loot, quests, factions, Mist, crafting, release date, system requirements, map, codes" canonical="/">
  <Fragment slot="schema"><script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite',
        '@id': 'https://scavland.wiki/#website',
        'name': 'Scavland Wiki',
        'alternateName': ['Scav Land', 'Scav Land Guide', 'Scavland Database'],
        'url': 'https://scavland.wiki',
        'description': 'The definitive Scavland Wiki (Scav Land Guide): comprehensive survival guides, cheats & console commands, weapons, attachments, factions, maps, and extraction mechanics for Zalesye.',
        'inLanguage': 'en-US',
        'dateModified': '2026-09-11T00:00:00Z',
        'sameAs': [
          'https://store.steampowered.com/app/3373500/Scavland/'
        ],
        'publisher': {
          '@type': 'Organization',
          '@id': 'https://scavland.wiki/#organization',
          'name': 'Scavland Wiki Editorial Team',
          'url': 'https://scavland.wiki',
          'logo': {
            '@type': 'ImageObject',
            'url': 'https://scavland.wiki/images/icons/logo.svg'
          }
        },
        'potentialAction': {
          '@type': 'SearchAction',
          'target': 'https://scavland.wiki/search/?q={search_term_string}',
          'query-input': 'required name=search_term_string'
        }
      },
      {
        '@type': 'FAQPage',
        '@id': 'https://scavland.wiki/#faq',
        'mainEntity': [
          {
            '@type': 'Question',
            'name': 'Are there official promo codes or cheat console commands for Scavland?',
            'acceptedAnswer': {
              '@type': 'Answer',
              'text': 'Currently in Early Access v0.5.169, there are no official promo codes or cheat console commands enabled for Scavland. Verified offline debug launch parameters and safe trainer utilities are documented in our Cheats Guide.'
            }
          },
          {
            '@type': 'Question',
            'name': 'What is Scavland and what type of game is it?',
            'acceptedAnswer': {
              '@type': 'Answer',
              'text': 'Scavland is a hardcore top-down pixel art survival RPG set in Zalesye, a post-apocalyptic Soviet wasteland ravaged by war and the toxic Mist. Players scavenge bunkers, master 25+ modular weapons with 300+ attachments, trade with 10 factions, and survive extraction runs.'
            }
          },
          {
            '@type': 'Question',
            'name': 'When was Scavland released and what platforms is it on?',
            'acceptedAnswer': {
              '@type': 'Answer',
              'text': 'Scavland launched on Steam Early Access on September 4, 2026 for PC (Windows) and is fully playable on Steam Deck at 60 FPS with 9W TDP optimization.'
            }
          }
        ]
      }
    ]
  })} /></Fragment>
  <section class="hero">
    <p class="eyebrow">Official Baseline · Community-Driven Wiki</p>
    <h1>Scavland Wiki &amp; Database</h1>
    <p class="lede">The complete database and tactical survival guide for <strong>Scavland (Scav Land)</strong>, a hardcore top-down pixel art survival RPG set in a post-apocalyptic Soviet wasteland. Explore Zalesye, scavenge abandoned bunkers, master 25+ weapons, navigate 10 factions, and survive the deadly Mist.</p>
    
    <Countdown />

    <div class="hero-actions">
      <a class="button" href="/guide/scavland-beginner-guide/">Beginner Guide (2026) <span aria-hidden="true">➔</span></a>
      <a class="button secondary" href="/guide/scavland-cheats-and-console-commands/">Cheats &amp; Console</a>
      <a class="button secondary" href="/weapons/">Tactical Arsenal</a>
      <a class="button secondary" href="https://store.steampowered.com/app/3373500/Scavland/" target="_blank" rel="noopener noreferrer">Play on Steam <span aria-hidden="true">↗</span></a>
    </div>

    <div class="hero-metrics-grid">
      <a class="metric-card" href="/weapons/">
        <span class="metric-value">25+</span>
        <span class="metric-label">Weapons Available</span>
        <span class="metric-sub">Pistols, Rifles &amp; Ballistics ➔</span>
      </a>
      <a class="metric-card" href="/weapons/">
        <span class="metric-value">300+</span>
        <span class="metric-label">Attachments Available</span>
        <span class="metric-sub">Optics, Muzzles &amp; Grips ➔</span>
      </a>
      <a class="metric-card" href="/factions/">
        <span class="metric-value">10</span>
        <span class="metric-label">Wasteland Factions</span>
        <span class="metric-sub">Vendor Tiers &amp; Reputations ➔</span>
      </a>
      <a class="metric-card" href="/release-date/">
        <span class="metric-value" style="color:var(--orange);">Sep 4, 2026</span>
        <span class="metric-label">Early Access Launch</span>
        <span class="metric-sub">Active Patch v0.5.169 ➔</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Quick Navigation</p>
        <h2>Scavland Database &amp; Hub</h2>
      </div>
      <p>Instant access to official launch facts, system requirements, tactical guides, and game mechanics.</p>
    </div>
    <div class="card-grid" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:1rem;">
      <a class="guide-card" href="/comparisons/scavland-vs-zero-sievert/" style="padding:1.25rem;display:block;text-decoration:none;border-radius:8px;border:1px solid var(--acid,#b9e86c);background:linear-gradient(135deg, rgba(185,232,108,0.06), #161616);">
        <span style="font-size:0.8rem;color:var(--acid,#b9e86c);font-weight:700;letter-spacing:1px;">★ FEATURED ANALYSIS</span>
        <h3 style="margin:0.5rem 0;font-size:1.1rem;color:#fff;">Scavland vs Zero Sievert</h3>
        <p style="font-size:0.85rem;color:var(--text-muted,#aaa);margin:0;">7 core differences: ballistics, 300+ attachments, Mist anomaly weather, and co-op roadmap.</p>
      </a>
      <a class="guide-card" href="/guide/scavland-beginner-guide/" style="padding:1.25rem;display:block;text-decoration:none;border-radius:8px;border:1px solid var(--border-color,#333);background:var(--card-bg,#161616);">
        <span style="font-size:0.8rem;color:var(--accent,#ffaa00);font-weight:700;letter-spacing:1px;">01 · SURVIVAL</span>
        <h3 style="margin:0.5rem 0;font-size:1.1rem;color:#fff;">Beginner Guide</h3>
        <p style="font-size:0.85rem;color:var(--text-muted,#aaa);margin:0;">Core gameplay loop, inventory management, first run survival, and extraction tips.</p>
      </a>
      <a class="guide-card" href="/release-date/" style="padding:1.25rem;display:block;text-decoration:none;border-radius:8px;border:1px solid var(--border-color,#333);background:var(--card-bg,#161616);">
        <span style="font-size:0.8rem;color:var(--accent,#ffaa00);font-weight:700;letter-spacing:1px;">02 · LAUNCH</span>
        <h3 style="margin:0.5rem 0;font-size:1.1rem;color:#fff;">Early Access &amp; Roadmap</h3>
        <p style="font-size:0.85rem;color:var(--text-muted,#aaa);margin:0;">Day 1 content scope, $19 pricing, community FAQ, and official development roadmap.</p>
      </a>
      <a class="guide-card" href="/system-requirements/" style="padding:1.25rem;display:block;text-decoration:none;border-radius:8px;border:1px solid var(--border-color,#333);background:var(--card-bg,#161616);">
        <span style="font-size:0.8rem;color:var(--accent,#ffaa00);font-weight:700;letter-spacing:1px;">03 · HARDWARE</span>
        <h3 style="margin:0.5rem 0;font-size:1.1rem;color:#fff;">System Requirements</h3>
        <p style="font-size:0.85rem;color:var(--text-muted,#aaa);margin:0;">Minimum and recommended PC specs, Steam Deck verification, and controller notes.</p>
      </a>
      <a class="guide-card" href="/weapons/" style="padding:1.25rem;display:block;text-decoration:none;border-radius:8px;border:1px solid var(--border-color,#333);background:var(--card-bg,#161616);">
        <span style="font-size:0.8rem;color:var(--accent,#ffaa00);font-weight:700;letter-spacing:1px;">04 · ARSENAL</span>
        <h3 style="margin:0.5rem 0;font-size:1.1rem;color:#fff;">Weapons &amp; Attachments Database</h3>
        <p style="font-size:0.85rem;color:var(--text-muted,#aaa);margin:0;">Interactive catalog of 25+ guns, 300+ attachments, ammo ballistics &amp; repair.</p>
      </a>
      <a class="guide-card" href="/factions/" style="padding:1.25rem;display:block;text-decoration:none;border-radius:8px;border:1px solid var(--border-color,#333);background:var(--card-bg,#161616);">
        <span style="font-size:0.8rem;color:var(--accent,#ffaa00);font-weight:700;letter-spacing:1px;">05 · FACTIONS</span>
        <h3 style="margin:0.5rem 0;font-size:1.1rem;color:#fff;">10 Wasteland Factions</h3>
        <p style="font-size:0.85rem;color:var(--text-muted,#aaa);margin:0;">Reputation system, faction vendors, hostile encounters, and contract jobs.</p>
      </a>
      <a class="guide-card" href="/maps/" style="padding:1.25rem;display:block;text-decoration:none;border-radius:8px;border:1px solid var(--border-color,#333);background:var(--card-bg,#161616);">
        <span style="font-size:0.8rem;color:var(--accent,#ffaa00);font-weight:700;letter-spacing:1px;">06 · EXPLORATION</span>
        <h3 style="margin:0.5rem 0;font-size:1.1rem;color:#fff;">Zalesye Map &amp; Bunkers</h3>
        <p style="font-size:0.85rem;color:var(--text-muted,#aaa);margin:0;">Overworld sector maps, radiation zones, anomaly clusters, and underground vaults.</p>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Start here</p>
        <h2>Essential wasteland field guides</h2>
      </div>
      <p>Every page distinguishes official claims from demonstrations and tests. Follow the question you actually have.</p>
    </div>
    <div class="guide-grid">{featured.map((guide, idx) => <GuideCard guide={guide} priority={idx < 2} />)}</div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Critical Acclaim &amp; Reception</p>
        <h2>Early Access Community Consensus</h2>
      </div>
      <p>Independent press and veteran survival creators share their day-one verdict on Scavland's atmosphere, gunplay, and hardcore extraction loop.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:1.25rem;">
      <div style="padding:1.5rem;background:var(--panel,#121a16);border:1px solid var(--line,#27382b);border-radius:6px;display:flex;flex-direction:column;justify-content:space-between;">
        <blockquote style="margin:0 0 1rem;font-size:0.95rem;line-height:1.6;color:var(--ink,#dcdcdc);font-style:italic;">
          &ldquo;Scavland could be my top indie game of 2026, if Early Access delivers. Atmospheric retro visuals, high quest density, deep exploration, and modular gunplay.&rdquo;
        </blockquote>
        <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(255,255,255,0.08);padding-top:0.75rem;">
          <span style="font-weight:700;color:var(--acid,#b9e86c);font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;">Insider Gaming</span>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:var(--muted,#888);">Launch Review</span>
        </div>
      </div>

      <div style="padding:1.5rem;background:var(--panel,#121a16);border:1px solid var(--line,#27382b);border-radius:6px;display:flex;flex-direction:column;justify-content:space-between;">
        <blockquote style="margin:0 0 1rem;font-size:0.95rem;line-height:1.6;color:var(--ink,#dcdcdc);font-style:italic;">
          &ldquo;A new post-apocalyptic survival sandbox that's hard to put down! Banger sound design, pixel sprite animations, rich enemy variety, and tense wasteland chaos.&rdquo;
        </blockquote>
        <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(255,255,255,0.08);padding-top:0.75rem;">
          <span style="font-weight:700;color:var(--acid,#b9e86c);font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;">Splattercatgaming</span>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:var(--muted,#888);">170K+ Views</span>
        </div>
      </div>

      <div style="padding:1.5rem;background:var(--panel,#121a16);border:1px solid var(--line,#27382b);border-radius:6px;display:flex;flex-direction:column;justify-content:space-between;">
        <blockquote style="margin:0 0 1rem;font-size:0.95rem;line-height:1.6;color:var(--ink,#dcdcdc);font-style:italic;">
          &ldquo;Scavland is a grim new survival RPG worth watching. Visceral combat encounters and hardcore extraction stakes make every foray count.&rdquo;
        </blockquote>
        <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(255,255,255,0.08);padding-top:0.75rem;">
          <span style="font-weight:700;color:var(--acid,#b9e86c);font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;">AddictingGames</span>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:var(--muted,#888);">First Look</span>
