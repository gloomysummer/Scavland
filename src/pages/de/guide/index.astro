---
import Layout from '../../../layouts/Layout.astro';
import GuideCard from '../../../components/GuideCard.astro';
import { allDeGuides } from '../../../data/guides-de';
---

<Layout title="Scavland Guides &amp; Handbücher | Scavland Wiki" description="Alle Scavland-Überlebensguides: Taktiken für Zalesye, Waffenmodifikationen, Fraktionen, Handwerk und Extraktion." canonical="/de/guide/" lang="de">
  <section class="listing">
    <p class="eyebrow">Hauptindex</p>
    <h1 class="page-title">Alle<br/><span style="color:var(--acid)">Guides.</span></h1>
    <p class="lede">Beginne mit dem Anfänger-Guide und vertiefe dein Wissen über Waffentuning, Anomalien und unterirdische Bunkerkomplexe.</p>
    <div class="listing-grid">
      {allDeGuides.map((guide) => <GuideCard guide={guide} lang="de" />)}
    </div>
  </section>
</Layout>
