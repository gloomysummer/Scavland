---
import Layout from '../../layouts/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { guides } from '../../data/guides';
const world = guides.filter((guide) => ['Exploration','Resources'].includes(guide.category));
---
<Layout 
  title="Scavland Map (Scav Land Locations) — Zalesye Overworld, Bunkers & Extraction Guide" 
  description="Verified Scavland map and world guide (Scav Land locations): Zalesye sector layout, underground bunkers, hazard radiation zones, Mist anomalies, and safe extraction routes." 
  keywords="Scavland map, Scav Land map, Scavland locations, Zalesye map, bunker locations, overworld map, Mist zones, extraction points, Scavland wiki" 
  canonical="/maps/"
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Scavland Wiki', item: 'https://scavland.wiki/' },
        { '@type': 'ListItem', position: 2, name: 'Map & World Locations', item: 'https://scavland.wiki/maps/' }
      ]
    })} />
  </Fragment>
  <section class="listing">
    <p class="eyebrow">World index</p>
    <h1 class="page-title">Read<br/><span style="color:var(--acid)">the world.</span></h1>
    <p class="lede">Locations are useful only when their evidence is clear. Start with the map notes, bunker access rules, and hazard guides.</p>
    <div class="listing-grid">{world.map((guide) => <GuideCard guide={guide} />)}</div>
  </section>
</Layout>
