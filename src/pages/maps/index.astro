---
import Layout from '../../layouts/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { guides } from '../../data/guides';
const world = guides.filter((guide) => ['Exploration','Resources'].includes(guide.category));
---
<Layout 
  title="Scavland Map — Zalesye Overworld & Bunker Locations" 
  description="Verified Scavland map and world guide: Zalesye sector layout, underground bunker locations, radiation hazard zones, Mist anomalies, and extraction routes." 
  keywords="Scavland map, Scavland locations, Zalesye map, bunker locations, overworld map, Mist zones, extraction points, Scavland wiki" 
  canonical="/maps/"
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Scavland Wiki', item: 'https://scavland.wiki/' },
        { '@type': 'ListItem', position: 2, name: 'Map & World Locations', item: 'https://scavland.wiki/maps/' }
      ]
    })} />
  </Fragment>
  <section class="listing">
    <p class="eyebrow">World Index · Tactical Cartography</p>
    <h1 class="page-title">Scavland Map &amp;<br/><span style="color:var(--acid)">Locations.</span></h1>
    <p class="lede">Locations are useful only when their evidence is clear. Start with the map notes, bunker access rules, and hazard guides.</p>
    <div class="listing-grid">{world.map((guide) => <GuideCard guide={guide} />)}</div>
  </section>
</Layout>
