---
import Layout from '../../layouts/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { guides } from '../../data/guides';
const systems = guides.filter((guide) => ['Systems','Gear','Progression','Economy'].includes(guide.category));
---
<Layout title="Scavland Game Systems & Mechanics — Scavland Wiki" description="Complete Scavland systems reference: weapons, attachments, crafting recipes, trader barter, cheats, quests, and faction mechanics." canonical="/wiki/" keywords="Scavland systems, Scavland wiki, Scavland mechanics, Scavland crafting, Scavland trading"><section class="listing"><p class="eyebrow">Systems index</p><h1 class="page-title">Scavland Game <br/><span style="color:var(--acid)">Systems &amp; Mechanics.</span></h1><p class="lede">A reference layer for the things you control: gear, jobs, factions, crafting and trade. Mechanics stay labelled until tested.</p><div class="listing-grid">{systems.map((guide) => <GuideCard guide={guide} />)}</div></section></Layout>
