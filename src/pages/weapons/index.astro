---
import Layout from '../../layouts/Layout.astro';
import AdsterraArticleBanner from '../../components/AdsterraArticleBanner.astro';
import { WEAPONS_DATABASE, ATTACHMENTS_CATALOG, BALLISTICS_CHART } from '../../data/weapons';

const categories = [
  { id: 'all', label: 'All Weapons' },
  { id: 'assault-rifle', label: 'Assault Rifles' },
  { id: 'battle-rifle', label: 'Battle Rifles' },
  { id: 'smg', label: 'SMGs' },
  { id: 'shotgun', label: 'Shotguns' },
  { id: 'sniper', label: 'Snipers & DMRs' },
  { id: 'sidearm', label: 'Sidearms' },
];
---

<Layout 
  title="Scavland Weapons Database — Ballistics, Attachments & Stats (Update 0.7.0)" 
  description="Complete Scavland weapons database: verified firearm damage, RPM, 300+ attachments, ammo penetration tiers, sidearm BIS tiering, and Update 0.7.0 durability & repair balance." 
  keywords="Scavland weapons, Scavland weapon, Scavland all weapons, Scavland attachments, firearms database, weapon stats, gun modification, ammo calibers, weapon repair, sidearm BIS, Scavland wiki" 
  canonical="/weapons/"
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Scavland Wiki', item: 'https://scavland.wiki/' },
        { '@type': 'ListItem', position: 2, name: 'Weapons & Attachments Database', item: 'https://scavland.wiki/weapons/' }
      ]
    })} />
  </Fragment>

  <article class="article-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb" style="font-size:0.82rem;color:var(--text-muted,#888);margin-bottom:1.25rem;display:flex;flex-wrap:wrap;gap:0.4rem;align-items:center;">
      <a href="/" style="color:var(--acid,#b9e86c);text-decoration:none;font-weight:600;">Scavland Wiki</a>
      <span style="opacity:0.4;">/</span>
      <span style="color:#bbb;">Weapons &amp; Attachments</span>
    </nav>

    <header class="article-header">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:12px;">
        <div style="display:inline-flex;align-items:center;gap:8px;padding:4px 10px;background:rgba(185,232,108,0.1);border:1px solid var(--acid,#b9e86c);border-radius:4px;">
          <span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--acid,#b9e86c);"></span>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:var(--acid,#b9e86c);font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">Early Access Update 0.7.0 Verified</span>
        </div>
        <a 
          href={`https://pinterest.com/pin/create/button/?url=${encodeURIComponent('https://scavland.wiki/weapons/')}&media=${encodeURIComponent('https://scavland.wiki/images/og-scavland.jpg')}&description=${encodeURIComponent('Scavland Complete Weapons & Attachments Tactical Database (Zalesye Arsenal)')}`}
          target="_blank" 
          rel="noopener noreferrer"
          style="display:inline-flex;align-items:center;gap:6px;padding:4px 10px;background:rgba(230,0,35,0.12);border:1px solid rgba(230,0,35,0.35);border-radius:4px;color:#ff6b7e;font-size:0.75rem;font-weight:600;text-decoration:none;transition:all 0.2s;"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="#e60023"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
          Pin Arsenal
        </a>
      </div>
      <h1 class="page-title">Scavland Weapons &amp; Ballistics Database</h1>
      <p class="lede">Comprehensive field catalog of verified firearms, 300+ modular attachment configurations, ballistic penetration tiers, recoil profiles, and weapon maintenance in Zalesye.</p>
      <span class="evidence">Evidence: Official Steam store page &amp; announcements · Update 0.7.0</span>
      <div style="margin: 1.25rem 0 0.5rem; padding: 0.75rem 1rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
        <span style="font-size: 0.85rem; color: var(--text-muted,#aaa);">Looking for body armor vests, plate carriers &amp; damage reduction?</span>
        <a href="/guide/scavland-armor-and-helmets-guide/" style="font-size: 0.82rem; color: var(--acid,#b9e86c); font-weight: 600; text-decoration: underline;">View Armor &amp; Helmets Guide →</a>
      </div>
    </header>

    <div class="article-layout">
      <div class="article-content">
        <!-- Visual Strip -->
        <div class="media-strip" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:0 0 24px;">
          <figure style="margin:0;">
            <img src="/images/screenshots/steam_ss_01.webp" alt="Scavland tactical firefight and weapon handling" style="width:100%;height:180px;border-radius:4px;border:1px solid var(--line);object-fit:cover;" loading="eager" fetchpriority="high" />
            <figcaption class="caption">Tactical firefight and ballistic dispersion during overworld exploration</figcaption>
          </figure>
          <figure style="margin:0;">
            <img src="/images/screenshots/steam_ss_10.webp" alt="Scavland weapon modification and attachment station" style="width:100%;height:180px;border-radius:4px;border:1px solid var(--line);object-fit:cover;" loading="lazy" />
            <figcaption class="caption">Modular attachment workbench: optics, muzzle devices, handguards, and magazines</figcaption>
          </figure>
        </div>

        <!-- Quick Summary Box -->
        <div class="quick-answer" style="margin-bottom:32px;">
          <strong style="color:var(--acid);font-size:1.05rem;">Zalesye Ballistic &amp; Gunplay Core Rules (Update 0.7.0 Verified)</strong>
          <ul style="margin:8px 0 0;padding-left:18px;line-height:1.7;color:var(--ink);">
            <li><strong>Caliber Dictates Armor Penetration:</strong> Bullet caliber and ammo sub-type determine penetration through enemy armor classes (Tier 1–5). In Update 0.7.0, shotguns apply a maximum of one bleed effect per shot instead of per pellet.</li>
            <li><strong>300+ Attachment Customization:</strong> Every firearm features modular modification points (stocks, magazines, optics, muzzle devices, grips). Update 0.7.0 added a 30-round magazine for the Thread Cutter and expanded stock compatibility across Bahadir, MK-47, 74u, and Borealis families.</li>
            <li><strong>Durability, Jams &amp; 30% Explosion Threshold (Update 0.7.0):</strong> In Update 0.7.0, weapon durability was significantly increased across almost the entire arsenal, with many rifles lasting twice as many shots per durability point. Hard jamming at 10% durability was reduced from 45% to 33%, and catastrophic weapon explosions only occur below 30% durability (previously 50%).</li>
            <li><strong>Secondary Weapon (Sidearm) BIS Selection:</strong> To preserve primary rifle durability against minor mutants, carry an efficient sidearm (PM Nikolay PB for silence, Leon 1895 Short for +50% stopping power, or Bahadir 918 Short for 15 shots/point longevity).</li>
          </ul>
        </div>

        <AdsterraArticleBanner label="Sponsored Tactical Intel" />

        <!-- Section 1: Interactive Weapon Roster -->
        <h2 id="roster">Interactive Firearms Catalog ({WEAPONS_DATABASE.length} Verified)</h2>
        <p style="color:var(--muted);margin-bottom:1.25rem;">Use the category filters or instant search bar below to filter guns by class, caliber, or tactical role.</p>

        <!-- Search & Filter Controls -->
        <div class="filter-wrapper" style="margin-bottom:1.5rem;">
          <div style="margin-bottom:0.75rem;">
            <input 
              type="text" 
              id="weapon-search" 
              placeholder="Search by weapon name, caliber (e.g. 5.45, 9x39), or role..." 
              style="width:100%;padding:10px 14px;background:#121a16;border:1px solid var(--line);border-radius:4px;color:var(--ink);font-family:inherit;font-size:0.9rem;"
            />
          </div>
          <div class="category-tabs" style="display:flex;flex-wrap:wrap;gap:8px;" role="tablist">
            {categories.map((cat, idx) => (
              <button 
                type="button" 
                class={`filter-tab ${idx === 0 ? 'active' : ''}`}
                data-category={cat.id}
                style="padding:6px 14px;background:rgba(255,255,255,0.03);border:1px solid var(--line);border-radius:4px;color:var(--muted);font-size:0.85rem;cursor:pointer;transition:all 0.2s;"
              >
                {cat.label}
              </button>
            ))}
          </div>
        </div>

        <!-- Weapon Cards Grid -->
        <div class="weapons-grid" id="weapons-container" style="display:grid;grid-template-columns:1fr;gap:20px;margin-bottom:3rem;">
          {WEAPONS_DATABASE.map((gun) => (
            <div 
              class="weapon-card" 
              data-cat={gun.category}
              data-search={`${gun.name} ${gun.caliber} ${gun.categoryLabel} ${gun.vendor}`.toLowerCase()}
              style="background:#121a16;border:1px solid var(--line);border-radius:6px;padding:20px;position:relative;"
            >
              <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:12px;">
                <div>
                  <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
                    <span style="font-size:0.7rem;font-family:'IBM Plex Mono',monospace;padding:2px 8px;border-radius:3px;background:rgba(255,255,255,0.06);color:var(--acid);">
                      {gun.categoryLabel}
                    </span>
                    <span style={`font-size:0.7rem;font-family:'IBM Plex Mono',monospace;padding:2px 8px;border-radius:3px;${
                      gun.tier === 'Endgame' ? 'background:rgba(227,145,85,0.15);color:var(--orange);border:1px solid rgba(227,145,85,0.3);' :
                      gun.tier === 'Mid-Tier' ? 'background:rgba(185,232,108,0.1);color:var(--acid);border:1px solid rgba(185,232,108,0.2);' :
                      'background:rgba(255,255,255,0.05);color:var(--muted);'
                    }`}>
                      {gun.tier} Tier
                    </span>
                  </div>
                  <h3 style="margin:0;font-size:1.35rem;color:#fff;">{gun.name}</h3>
                  <div style="font-family:'IBM Plex Mono',monospace;font-size:0.85rem;color:var(--acid);margin-top:2px;">
                    Caliber: <strong>{gun.caliber}</strong>
                  </div>
                </div>

                <!-- Stats Badges -->
                <div style="display:flex;gap:12px;text-align:right;">
                  <div style="background:rgba(0,0,0,0.3);padding:6px 10px;border-radius:4px;border:1px solid rgba(255,255,255,0.05);">
                    <span style="font-size:0.7rem;color:var(--muted);display:block;text-transform:uppercase;">Damage</span>
                    <strong style="font-size:1.15rem;color:#fff;font-family:'Barlow Condensed',sans-serif;">{gun.damage}</strong>
                  </div>
                  <div style="background:rgba(0,0,0,0.3);padding:6px 10px;border-radius:4px;border:1px solid rgba(255,255,255,0.05);">
                    <span style="font-size:0.7rem;color:var(--muted);display:block;text-transform:uppercase;">RPM</span>
                    <strong style="font-size:1.15rem;color:#fff;font-family:'Barlow Condensed',sans-serif;">{gun.rpm}</strong>
                  </div>
                  <div style="background:rgba(0,0,0,0.3);padding:6px 10px;border-radius:4px;border:1px solid rgba(255,255,255,0.05);">
                    <span style="font-size:0.7rem;color:var(--muted);display:block;text-transform:uppercase;">Range</span>
                    <strong style="font-size:1.15rem;color:#fff;font-family:'Barlow Condensed',sans-serif;">{gun.effectiveRange}</strong>
                  </div>
                </div>
              </div>

              <!-- Stats Progress Bars -->
              <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));gap:12px;margin:14px 0;padding:12px;background:rgba(0,0,0,0.25);border-radius:4px;">
                <div>
                  <div style="display:flex;justify-content:space-between;font-size:0.75rem;color:var(--muted);margin-bottom:3px;">
                    <span>Recoil Control</span>
                    <span style="color:#fff;">{gun.recoilControl}%</span>
                  </div>
                  <div style="height:5px;background:rgba(255,255,255,0.1);border-radius:3px;overflow:hidden;">
                    <div style={`height:100%;background:var(--acid);width:${gun.recoilControl}%;`}></div>
                  </div>
                </div>
                <div>
                  <div style="display:flex;justify-content:space-between;font-size:0.75rem;color:var(--muted);margin-bottom:3px;">
                    <span>Mag Capacity</span>
                    <span style="color:#fff;">{gun.magCapacity} rnds</span>
                  </div>
                  <div style="height:5px;background:rgba(255,255,255,0.1);border-radius:3px;overflow:hidden;">
                    <div style={`height:100%;background:var(--orange);width:${Math.min(100, (gun.magCapacity / 60) * 100)}%;`}></div>
                  </div>
                </div>
                <div>
                  <div style="display:flex;justify-content:space-between;font-size:0.75rem;color:var(--muted);margin-bottom:3px;">
                    <span>Weight</span>
                    <span style="color:#fff;">{gun.weightKg} kg</span>
                  </div>
                  <div style="height:5px;background:rgba(255,255,255,0.1);border-radius:3px;overflow:hidden;">
                    <div style={`height:100%;background:#88b5ff;width:${Math.min(100, (gun.weightKg / 5) * 100)}%;`}></div>
                  </div>
                </div>
              </div>

              <p style="font-size:0.9rem;line-height:1.6;color:var(--ink);margin:10px 0;">{gun.description}</p>

              <!-- Mod Slots -->
              <div style="margin:12px 0 8px;">
                <span style="font-size:0.72rem;color:var(--muted);text-transform:uppercase;font-family:'IBM Plex Mono',monospace;letter-spacing:0.05em;display:block;margin-bottom:5px;">Modular Slots:</span>
                <div style="display:flex;flex-wrap:wrap;gap:6px;">
                  {gun.modSlots.map((slot) => (
                    <span style="font-size:0.75rem;padding:2px 8px;border-radius:3px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#bbb;">
                      {slot}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Recommended Build -->
              <div style="margin-top:12px;padding:10px 14px;background:rgba(185,232,108,0.04);border-left:3px solid var(--acid);border-radius:0 4px 4px 0;font-size:0.85rem;">
                <strong style="color:var(--acid);">Recommended Stalker Build:</strong> 
                <span style="color:var(--ink);">{gun.recommendedBuild}</span>
              </div>

              <div style="margin-top:8px;font-size:0.78rem;color:var(--muted);">
                <strong>Obtained From:</strong> {gun.vendor}
              </div>
            </div>
          ))}
        </div>

        <!-- Section 2: Ballistics & Armor Penetration Chart -->
        <h2 id="ballistics">Ammunition Ballistics &amp; Penetration Matrix</h2>
        <p>In Scavland, armor protects targets based on 5 discrete resistance tiers. Choosing the proper cartridge determines whether a bullet punches through enemy body armor or ricochets harmlessly.</p>

        <div class="table-responsive" style="overflow-x:auto;margin:20px 0 35px;">
          <table class="facts" style="width:100%;border-collapse:collapse;">
            <thead>
              <tr style="border-bottom:2px solid var(--line);background:rgba(255,255,255,0.03);">
                <th style="padding:10px;text-align:left;color:var(--acid);font:.72rem 'IBM Plex Mono';">CALIBER</th>
                <th style="padding:10px;text-align:left;color:var(--acid);font:.72rem 'IBM Plex Mono';">STANDARD ROUNDS</th>
                <th style="padding:10px;text-align:left;color:var(--acid);font:.72rem 'IBM Plex Mono';">ARMOR PEN TIER</th>
                <th style="padding:10px;text-align:left;color:var(--acid);font:.72rem 'IBM Plex Mono';">BASE DAMAGE</th>
                <th style="padding:10px;text-align:left;color:var(--acid);font:.72rem 'IBM Plex Mono';">BLEED CHANCE</th>
                <th style="padding:10px;text-align:left;color:var(--acid);font:.72rem 'IBM Plex Mono';">BEST TACTICAL USE</th>
              </tr>
            </thead>
            <tbody>
              {BALLISTICS_CHART.map((b) => (
                <tr style="border-bottom:1px solid rgba(255,255,255,0.06);">
                  <td style="font-weight:700;color:var(--acid);font-family:'IBM Plex Mono',monospace;">{b.caliber}</td>
                  <td style="font-size:0.85rem;color:#ccc;">{b.rounds}</td>
                  <td>
                    <div style="display:flex;gap:4px;align-items:center;">
                      <span class={`tier-pill tier-${b.penTier}`}>
                        Tier {b.penTier}
                      </span>
                      <div style="display:flex;gap:2px;margin-left:4px;">
                        {[1, 2, 3, 4, 5].map((level) => (
                          <span style={`width:8px;height:8px;border-radius:1px;display:inline-block;${
                            level <= b.penTier ? 
                              (b.penTier === 5 ? 'background:var(--t5-gold);box-shadow:0 0 4px var(--t5-gold);' :
                               b.penTier === 4 ? 'background:var(--t4-purple);' :
                               b.penTier === 3 ? 'background:var(--t3-blue);' :
                               b.penTier === 2 ? 'background:var(--t2-green);' : 'background:var(--t1-white);') :
                              'background:rgba(255,255,255,0.1);'
                          }`}></span>
                        ))}
                      </div>
                    </div>
                  </td>
                  <td style="font-size:0.9rem;font-weight:600;">{b.damageRating}</td>
                  <td style="font-size:0.85rem;color:var(--orange);">{b.bleedChance}</td>
                  <td style="font-size:0.85rem;color:var(--muted);line-height:1.4;">{b.bestUse}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Section 3: 300+ Modular Attachment System -->
        <h2 id="attachments">300+ Attachment Customization System</h2>
        <p>Scavland’s weapon bench allows modular replacement of muzzle devices, optics rails, ergonomic foregrips, drum magazines, and folding buttstocks. Below are representative high-impact attachments verified in Early Access:</p>

        <div style="overflow-x:auto;margin:20px 0 35px;">
          <table class="facts" style="width:100%;border-collapse:collapse;">
            <thead>
              <tr style="border-bottom:2px solid var(--line);background:rgba(255,255,255,0.03);">
                <th style="padding:10px;text-align:left;color:var(--acid);font:.72rem 'IBM Plex Mono';">SLOT</th>
                <th style="padding:10px;text-align:left;color:var(--acid);font:.72rem 'IBM Plex Mono';">ATTACHMENT NAME</th>
                <th style="padding:10px;text-align:left;color:var(--acid);font:.72rem 'IBM Plex Mono';">PRIMARY EFFECT</th>
                <th style="padding:10px;text-align:left;color:var(--acid);font:.72rem 'IBM Plex Mono';">RECOIL IMPACT</th>
                <th style="padding:10px;text-align:left;color:var(--acid);font:.72rem 'IBM Plex Mono';">COMPATIBILITY</th>
                <th style="padding:10px;text-align:left;color:var(--acid);font:.72rem 'IBM Plex Mono';">STALKER TIP</th>
              </tr>
            </thead>
            <tbody>
              {ATTACHMENTS_CATALOG.map((att) => (
                <tr style="border-bottom:1px solid rgba(255,255,255,0.06);">
                  <td style="font-weight:700;color:var(--acid);font-size:0.8rem;font-family:'IBM Plex Mono',monospace;">{att.category}</td>
                  <td style="font-weight:600;color:#fff;">{att.name}</td>
                  <td style="font-size:0.85rem;color:var(--ink);">{att.effect}</td>
                  <td style="font-size:0.82rem;color:var(--acid);font-family:'IBM Plex Mono',monospace;">{att.recoilMod}</td>
                  <td style="font-size:0.82rem;color:var(--muted);">{att.compatibility}</td>
                  <td style="font-size:0.82rem;color:#aaa;line-height:1.4;">{att.tacticalTip}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Section 4: Durability & Jams -->
        <h2 id="durability">Durability, Jam Probability &amp; Field Repairs (Update 0.7.0)</h2>
        <p>In Update 0.7.0, weapon durability was significantly increased across almost the entire arsenal. Maintaining your firearms remains crucial, but gun upkeep is far less punishing:</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:14px;margin:20px 0;">
          <div style="padding:14px;background:#121a16;border:1px solid rgba(185,232,108,0.3);border-radius:6px;">
            <div style="font-size:0.75rem;color:var(--acid);font-family:'IBM Plex Mono',monospace;text-transform:uppercase;">100% - 80% Condition</div>
            <h4 style="margin:4px 0 8px;color:#fff;">Pristine Condition</h4>
            <p style="margin:0;font-size:0.85rem;color:var(--muted);line-height:1.5;">0% jam chance. Maximum bullet velocity and pinpoint accuracy. Glue and Gun Lube can be used from 80% durability (previously 85%) for routine maintenance.</p>
          </div>
          <div style="padding:14px;background:#121a16;border:1px solid rgba(136,181,255,0.3);border-radius:6px;">
            <div style="font-size:0.75rem;color:#88b5ff;font-family:'IBM Plex Mono',monospace;text-transform:uppercase;">79% - 70% Condition</div>
            <h4 style="margin:4px 0 8px;color:#fff;">Field Serviceable</h4>
            <p style="margin:0;font-size:0.85rem;color:var(--muted);line-height:1.5;">Cleaning Rods and Field Repair Kits can be used from 70% durability (previously 75%) without needing a workbench station.</p>
          </div>
          <div style="padding:14px;background:#121a16;border:1px solid rgba(227,145,85,0.3);border-radius:6px;">
            <div style="font-size:0.75rem;color:var(--orange);font-family:'IBM Plex Mono',monospace;text-transform:uppercase;">69% - 30% Condition</div>
            <h4 style="margin:4px 0 8px;color:#fff;">Fouled Chamber &amp; Jams</h4>
            <p style="margin:0;font-size:0.85rem;color:var(--muted);line-height:1.5;">Weapon jamming begins later in Update 0.7.0. At 10% durability, hard-jam chance has been reduced from 45% down to 33%.</p>
          </div>
          <div style="padding:14px;background:#121a16;border:1px solid rgba(255,80,80,0.4);border-radius:6px;">
            <div style="font-size:0.75rem;color:#ff6b6b;font-family:'IBM Plex Mono',monospace;text-transform:uppercase;">Below 30% Condition</div>
            <h4 style="margin:4px 0 8px;color:#fff;">Catastrophic Explosion Risk</h4>
            <p style="margin:0;font-size:0.85rem;color:var(--muted);line-height:1.5;">Guns can now explode below 30% durability instead of 50%. Gun and Armor Repair Kits can now be used regardless of equipment damage condition.</p>
          </div>
        </div>

        <p><strong>Field Maintenance Checklist &amp; Repair Kit Loot Tiers:</strong></p>
