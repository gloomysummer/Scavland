---
import Layout from '../../../layouts/Layout.astro';
import GuideCard from '../../../components/GuideCard.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { allJaGuides, jaGuideBySlug } from '../../../data/guides-ja';

export function getStaticPaths() {
  return allJaGuides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const related = guide.related.map((slug) => jaGuideBySlug[slug]).filter(Boolean);
const canonicalUrl = `https://scavland.wiki/ja/guide/${guide.slug}/`;
const imageUrl = `https://scavland.wiki${guide.image.startsWith('/images') ? guide.image : '/images/hero/header.webp'}`;

// Series pagination calculations
const categoryGuides = allJaGuides.filter((g) => g.category === guide.category);
const seriesIndex = categoryGuides.findIndex((g) => g.slug === guide.slug);
const prevGuide = seriesIndex > 0 ? categoryGuides[seriesIndex - 1] : null;
const nextGuide = seriesIndex >= 0 && seriesIndex < categoryGuides.length - 1 ? categoryGuides[seriesIndex + 1] : null;

// All Wiki Channels for right sidebar navigation tree
const allCategories = Array.from(new Set(allJaGuides.map((g) => g.category)));

// 1. Article Schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  image: imageUrl,
  inLanguage: 'ja-JP',
  datePublished: '2026-08-20T00:00:00Z',
  dateModified: `${guide.updated}T00:00:00Z`,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  author: {
    '@type': 'Organization',
    name: 'Scavland Wiki 日本語編集部',
    url: 'https://scavland.wiki/ja/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Scavland Wiki',
    url: 'https://scavland.wiki',
    logo: 'https://scavland.wiki/images/icons/logo.svg',
  },
  about: {
    '@type': 'VideoGame',
    name: 'Scavland',
    url: 'https://store.steampowered.com/app/3373500/Scavland/',
  },
};

// 2. BreadcrumbList Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Scavland Wiki',
      item: 'https://scavland.wiki/ja/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '攻略ガイド',
      item: 'https://scavland.wiki/ja/guide/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: guide.title,
      item: canonicalUrl,
    },
  ],
};

// 3. FAQPage Schema
const faqSchema = guide.faq && guide.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faq.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: answer,
    },
  })),
} : null;

// Construct gold-standard SEO title (<= 60 chars)
const coreTitle = guide.title.includes(':') ? guide.title.split(':')[0].trim() : guide.title;
const subtitle = guide.title.includes(':') ? guide.title.split(':')[1].trim() : null;

let pageTitle = `${coreTitle} — Scavland Wiki 日本語`;
if (pageTitle.length > 60) {
  pageTitle = `${coreTitle} | Wiki 日本語`;
}
if (pageTitle.length > 60) {
  pageTitle = `${guide.shortTitle || coreTitle} — Wiki 日本語`;
}
---

<Layout title={pageTitle} description={guide.description} canonical={`/ja/guide/${guide.slug}/`} lang="ja">
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <div class="guide-layout">
    <!-- Ad Placement 2: Left Skyscraper (>= 1440px only) -->
    <aside class="ad-skyscraper-left" aria-label="Sponsored Recon">
      <AdSlot slot="banner-160x600" label="Sponsored Recon" />
    </aside>

    <article class="article-shell">
      <nav class="breadcrumbs" aria-label="Navigation" style="font-size:0.85rem;color:var(--text-muted,#888);margin-bottom:1.25rem;display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;">
        <a href="/ja/" style="color:var(--acid,#b9e86c);text-decoration:none;font-weight:600;padding:4px 2px;min-height:36px;display:inline-flex;align-items:center;">Scavland Wiki</a>
        <span style="opacity:0.4;">/</span>
        <a href="/ja/guide/" style="color:var(--text-muted,#aaa);text-decoration:none;padding:4px 2px;min-height:36px;display:inline-flex;align-items:center;">攻略ガイド</a>
        <span style="opacity:0.4;">/</span>
        <span style="color:#bbb;padding:4px 0;">{coreTitle}</span>
      </nav>

      <header class="article-header">
        <p class="eyebrow">{guide.category} · 更新日 {guide.updated}</p>
        <h1 class="page-title">{coreTitle}</h1>
        {subtitle && (
          <p class="subtitle" style="font-family:'IBM Plex Mono',monospace;font-size:0.9rem;color:var(--acid,#b9e86c);margin:-0.25rem 0 1rem;letter-spacing:0.02em;font-weight:600;">
            {subtitle}
          </p>
        )}
        <p class="lede">{guide.description}</p>
        <span class="evidence">検証データ：{guide.evidence}</span>
      </header>

      <!-- Ad Placement 1: Top Leaderboard (Desktop 728x90 / Mobile 320x50) -->
      <div class="ad-placement-top">
        <div class="ad-desktop-only">
          <AdSlot slot="banner-728x90" label="Sponsored Field Intel" />
        </div>
        <div class="ad-mobile-only">
          <AdSlot slot="banner-320x50" label="Sponsored Field Intel" />
        </div>
      </div>

      <!-- Mobile Collapsible Table of Contents -->
      <details class="toc-mobile" style="display:none;background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:12px 16px;margin:24px 0;">
        <summary style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;font-weight:700;color:var(--acid);cursor:pointer;text-transform:uppercase;letter-spacing:0.06em;user-select:none;display:flex;align-items:center;min-height:44px;">
          目次 (セクションへ移動 ▾)
        </summary>
        <div style="display:flex;flex-direction:column;gap:6px;margin-top:10px;padding-top:10px;border-top:1px solid rgba(255,255,255,0.06);font-size:0.88rem;">
          <a href="#field-notes" style="color:var(--ink);min-height:44px;display:flex;align-items:center;padding:0 4px;">→ 戦術フィールドノート</a>
          <a href="#evidence" style="color:var(--ink);min-height:44px;display:flex;align-items:center;padding:0 4px;">→ 検証データ・仕様</a>
          <a href="#faq" style="color:var(--ink);min-height:44px;display:flex;align-items:center;padding:0 4px;">→ よくある質問</a>
          <a href="#related" style="color:var(--ink);min-height:44px;display:flex;align-items:center;padding:0 4px;">→ 関連ガイド</a>
        </div>
      </details>

      <div class="article-layout">
        <div class="article-content">
          <div class="quick-answer">
            <strong>クイックアンサー</strong><span set:html={guide.answer} />
          </div>

          <div class="article-media">
            {guide.image.endsWith('.mp4') ? (
              <video src={guide.image} controls muted playsinline preload="metadata" aria-label={guide.imageAlt}></video>
            ) : (
              <img src={guide.image} alt={guide.imageAlt} />
            )}
          </div>
          <p class="caption">
            メディア：実機検証データおよびゲーム素材 · {guide.evidence}。
          </p>

          <h2 id="field-notes">戦術フィールドノート</h2>
          <ul>
            {guide.steps.map((step) => <li set:html={step} />)}
          </ul>

          <!-- Ad Placement 4: In-Article Native Intel -->
          <AdSlot slot="native" label="Sponsored Strategic Intel" />

          <h2 id="evidence">検証データ＆仕様詳細</h2>
          <div class="table-responsive" style="overflow-x:auto;-webkit-overflow-scrolling:touch;max-width:100%;margin:16px 0;">
            <table class="facts">
              <tbody>
                {guide.facts.map(([key, value]) => (
                  <tr>
                    <td>{key}</td>
                    <td set:html={value} />
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h2 id="faq">よくある質問 (FAQ)</h2>
          <div class="faq-list">
            {guide.faq.map(([question, answer]) => (
              <details>
                <summary set:html={question} />
                <p set:html={answer} />
              </details>
            ))}
          </div>

          <h2 id="related">関連ガイド</h2>
          <div class="related-grid">
            {related.map((item) => <GuideCard guide={item} lang="ja" />)}
          </div>

          <!-- Series Pagination: Previous / All Guides / Next -->
          <nav class="guide-pagination" aria-label="Series Guide Navigation">
            <div class="pagination-col prev">
              {prevGuide ? (
                <a href={`/ja/guide/${prevGuide.slug}/`} class="pagination-card">
                  <span class="pagination-label">← 前のガイド</span>
                  <span class="pagination-title">{prevGuide.shortTitle || prevGuide.title}</span>
                </a>
              ) : (
                <div class="pagination-placeholder"></div>
              )}
            </div>
            <div class="pagination-col center">
              <a href="/ja/guide/" class="pagination-all-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                <span>全ガイド一覧</span>
              </a>
            </div>
            <div class="pagination-col next">
              {nextGuide ? (
                <a href={`/ja/guide/${nextGuide.slug}/`} class="pagination-card">
                  <span class="pagination-label">次のガイド →</span>
                  <span class="pagination-title">{nextGuide.shortTitle || nextGuide.title}</span>
                </a>
              ) : (
                <div class="pagination-placeholder"></div>
              )}
            </div>
          </nav>

          <!-- Ad Placement 5: Footer Leaderboard (Desktop 728x90 / Mobile 320x50) -->
          <div class="ad-placement-bottom">
            <div class="ad-desktop-only">
              <AdSlot slot="banner-728x90" label="Sponsored Archive Intel" />
            </div>
            <div class="ad-mobile-only">
              <AdSlot slot="banner-320x50" label="Sponsored Archive Intel" />
            </div>
          </div>
        </div>

        <div class="sidebar-column">
          <!-- Ad Placement 3: Right Sidebar 300x250 (Top of sidebar above TOC) -->
          <div class="sidebar-ad-section">
            <AdSlot slot="banner-300x250" label="Sponsored Field Intel" />
          </div>

          <!-- Module 0: Wiki Navigation (Placed above ON THIS PAGE) -->
          <div class="sidebar-section wiki-navigation-section">
            <div class="wiki-nav-title">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
              <span>WIKI NAVIGATION</span>
            </div>
            <ul class="wiki-nav-list">
              <li class="wiki-nav-channel">
                <a href="/ja/" class="wiki-nav-channel-link">
                  <span class="channel-arrow">›</span>
                  <span>ホーム</span>
                </a>
              </li>
              <li class="wiki-nav-channel">
                <a href="/ja/guide/" class="wiki-nav-channel-link">
                  <span class="channel-arrow">›</span>
                  <span>攻略ガイド一覧</span>
                </a>
              </li>
              {allCategories.map((cat) => {
                const isCurrentCat = cat === guide.category;
                const catGuides = allJaGuides.filter((g) => g.category === cat);
                const firstGuideOfCat = catGuides[0];
                return (
                  <li class={`wiki-nav-channel ${isCurrentCat ? 'is-active-channel' : ''}`}>
                    <a 
                      href={`/ja/guide/${firstGuideOfCat.slug}/`} 
                      class={`wiki-nav-channel-link ${isCurrentCat ? 'is-current' : ''}`}
                      aria-current={isCurrentCat ? 'page' : undefined}
                    >
                      <span class="channel-arrow">{isCurrentCat ? '▼' : '›'}</span>
                      <span>{cat}</span>
                      <span class="sidebar-count-badge">{catGuides.length}</span>
                    </a>
                    {isCurrentCat && (
                      <ul class="wiki-nav-sublist">
                        {catGuides.map((cg) => {
                          const isCurrentArticle = cg.slug === guide.slug;
                          return (
                            <li class={`wiki-nav-subitem ${isCurrentArticle ? 'is-active-article' : ''}`}>
                              <a href={`/ja/guide/${cg.slug}/`} class="wiki-nav-sublink" aria-current={isCurrentArticle ? 'page' : undefined}>
                                <span class="sublink-bullet">{isCurrentArticle ? '●' : '○'}</span>
                                <span class="sublink-text">{cg.shortTitle || cg.title}</span>
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    )}
                  </li>
                );
              })}
            </ul>

            <!-- Active Codes Micro-Widget -->
            <div class="sidebar-codes-widget">
              <div class="codes-widget-header">
                <div class="codes-title-group">
                  <span class="codes-title-text">ACTIVE CODES</span>
                </div>
                <span class="codes-badge">VERIFIED</span>
              </div>
              <p class="codes-status">None / No active codes yet. Check back soon!</p>
            </div>
          </div>

          <aside class="toc" aria-label="目次">
            <strong>目次</strong>
            <a href="#field-notes">戦術フィールドノート</a>
            <a href="#evidence">検証データ・仕様</a>
            <a href="#faq">よくある質問</a>
            <a href="#related">関連ガイド</a>
          </aside>
        </div>
      </div>
    </article>
  </div>
</Layout>
