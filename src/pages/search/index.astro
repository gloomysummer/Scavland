---
import Layout from '../../layouts/Layout.astro';
import { guides } from '../../data/guides';
---
<Layout title="Search Scavland guides | Scavland Wiki" description="Search evidence-labelled Scavland guides for survival, weapons, loot, quests, factions and exploration." canonical="/search/"><section class="listing"><p class="eyebrow">Field index</p><h1 class="page-title">Search<br/><span style="color:var(--acid)">the notes.</span></h1><input class="search-box" id="guide-search" type="search" placeholder="Try “mist”, “loot” or “weapons”" aria-label="Search Scavland guides"/><div class="listing-grid" id="results">{guides.map((guide) => <a class="guide-card" data-search={`${guide.title} ${guide.description} ${guide.keywords.join(' ')}`} href={`/guide/${guide.slug}/`}><div class="card-copy"><span class="eyebrow">{guide.category} · {guide.evidence}</span><h3>{guide.shortTitle}</h3><p>{guide.description}</p><span class="read-link">Open guide ↗</span></div></a>)}</div></section><script is:inline>{`const input=document.querySelector('#guide-search');const cards=[...document.querySelectorAll('[data-search]')];input?.addEventListener('input',()=>{const q=input.value.toLowerCase();cards.forEach(card=>card.hidden=q&&!card.dataset.search.toLowerCase().includes(q));});document.addEventListener('keydown',e=>{if(e.key==='/'&&document.activeElement!==input){e.preventDefault();input?.focus();}});`}</script></Layout>
