---
// Countdown component with instant live status detection
---

<div class="launch-live-card" id="scavland-launch-banner">
  <div class="status-badge-wrap">
    <span class="live-pulse"></span>
    <span class="status-badge-text">STEAM EARLY ACCESS: NOW LIVE</span>
  </div>

  <div class="launch-details">
    <div class="launch-meta">
      <div class="launch-title">Scavland Official Release</div>
      <div class="launch-subtitle">Launched Worldwide: <strong>September 4, 2026</strong> · PC (Steam)</div>
    </div>

    <div class="launch-pricing-box">
      <div class="price-item">
        <span class="price-tag">Standard Edition</span>
        <span class="price-val">$19.00 USD</span>
      </div>
      <div class="price-item discount">
        <span class="price-tag">Launch Deal</span>
        <span class="price-val discount-val">10% OFF ($17.10)</span>
      </div>
    </div>
  </div>

  <div class="launch-actions">
    <a 
      href="https://store.steampowered.com/app/3373500/Scavland/" 
      target="_blank" 
      rel="noopener noreferrer"
      class="steam-cta-btn"
    >
      <span>View on Steam Store</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.415l2.49-3.66a3.52 3.52 0 0 1-1.035-2.52c0-1.95 1.59-3.54 3.54-3.54.495 0 .96.105 1.395.285l3.225-4.665A5.955 5.955 0 0 0 12 6c-3.315 0-6 2.685-6 6 0 .525.075 1.035.21 1.515L2.4 15.195C1.515 14.235 1 12.975 1 11.6c0-5.85 4.755-10.6 10.6-10.6 5.85 0 10.6 4.755 10.6 10.6 0 5.85-4.755 10.6-10.6 10.6-1.53 0-2.97-.33-4.275-.915l2.79-4.11c.465.18.975.285 1.485.285 2.22 0 4.02-1.8 4.02-4.02 0-2.22-1.8-4.02-4.02-4.02-2.22 0-4.02 1.8-4.02 4.02 0 .39.06.765.165 1.125L4.83 16.92A10.51 10.51 0 0 0 12 22.6c5.85 0 10.6-4.755 10.6-10.6C22.6 5.37 17.85 0 12 0z"/>
      </svg>
    </a>
    <a href="#content" class="scope-cta-btn">
      What's in Day 1 Build ↓
    </a>
  </div>
</div>

<style>
  .launch-live-card {
    background: linear-gradient(135deg, rgba(185, 232, 108, 0.08) 0%, rgba(18, 26, 22, 0.9) 100%);
    border: 1px solid var(--acid, #b9e86c);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 1.5rem 0 2rem;
    box-shadow: 0 4px 24px rgba(0,0,0,0.4), inset 0 0 12px rgba(185,232,108,0.05);
  }

  .status-badge-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    background: rgba(185, 232, 108, 0.15);
    border: 1px solid var(--acid, #b9e86c);
    border-radius: 4px;
    margin-bottom: 12px;
  }

  .live-pulse {
    width: 8px;
    height: 8px;
    background: var(--acid, #b9e86c);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--acid, #b9e86c);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(185, 232, 108, 0.7); }
    70% { transform: scale(1.1); box-shadow: 0 0 0 8px rgba(185, 232, 108, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(185, 232, 108, 0); }
  }

  .status-badge-text {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--acid, #b9e86c);
    letter-spacing: 0.08em;
  }

  .launch-details {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .launch-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #fff;
    font-family: 'Barlow Condensed', sans-serif;
    letter-spacing: 0.02em;
  }

  .launch-subtitle {
    font-size: 0.9rem;
    color: var(--muted, #9aa9a0);
    margin-top: 4px;
  }

  .launch-subtitle strong {
    color: #fff;
  }

  .launch-pricing-box {
    display: flex;
    gap: 12px;
  }

  .price-item {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--line, #26362e);
    border-radius: 4px;
    padding: 6px 12px;
    text-align: right;
  }

  .price-item.discount {
    border-color: rgba(227, 145, 85, 0.5);
    background: rgba(227, 145, 85, 0.1);
  }

  .price-tag {
    display: block;
    font-size: 0.65rem;
    font-family: 'IBM Plex Mono', monospace;
    color: var(--muted, #9aa9a0);
    text-transform: uppercase;
  }

  .price-val {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    font-family: 'Barlow Condensed', sans-serif;
  }

  .discount-val {
    color: var(--orange, #e39155);
  }

  .launch-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1.2rem;
  }

  .steam-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--acid, #b9e86c);
    color: #0b100e !important;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 8px 18px;
    border-radius: 4px;
    text-decoration: none;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .steam-cta-btn:hover {
    background: #cbf587;
    transform: translateY(-1px);
  }

  .scope-cta-btn {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--line, #26362e);
    color: var(--ink, #e7eee9) !important;
    font-size: 0.9rem;
    padding: 8px 16px;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .scope-cta-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 640px) {
    .launch-details {
      flex-direction: column;
      align-items: flex-start;
    }
    .launch-pricing-box {
      width: 100%;
    }
    .price-item {
      flex: 1;
      text-align: left;
    }
    .launch-actions {
      flex-direction: column;
    }
    .steam-cta-btn, .scope-cta-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
