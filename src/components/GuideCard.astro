---
import { getLocalizedUrl, uiTranslations, type Language } from '../data/i18n';

interface Props {
  guide: any;
  priority?: boolean;
  lang?: Language;
}

const { guide, priority = false, lang = 'en' } = Astro.props;
const isVideo = guide.image && guide.image.endsWith('.mp4');
const targetUrl = getLocalizedUrl(`/guide/${guide.slug}/`, lang);
const t = uiTranslations[lang] || uiTranslations.en;
---
<a class="guide-card" href={targetUrl}><div class="card-media">{isVideo ? <video src={guide.image} muted loop autoplay playsinline aria-label={guide.imageAlt}></video> : <img src={guide.image} alt={guide.imageAlt} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" width="480" height="330" />}</div><div class="card-copy"><span class="eyebrow">{guide.category} · {guide.evidence}</span><h3>{guide.shortTitle || guide.title}</h3><p>{guide.description}</p><span class="read-link">{t.common.readFieldNotes} <span aria-hidden="true">↗</span></span></div></a>

