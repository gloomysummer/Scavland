---
import { adConfig } from '../data/adConfig';

type AdSlotType =
  | 'banner-728x90'
  | 'banner-160x600'
  | 'banner-160x300'
  | 'banner-320x50'
  | 'banner-300x250'
  | 'banner300x250'
  | 'native';

interface Props {
  slot: AdSlotType;
  className?: string;
  label?: string;
}

const { slot, className = '', label = 'Advertisement' } = Astro.props;

const isGlobalEnabled = adConfig.enabled && adConfig.provider === 'adsterra';

// Normalize slot alias
type BannerKey = 'banner-728x90' | 'banner-160x600' | 'banner-160x300' | 'banner-320x50' | 'banner-300x250';
const normalizedSlot: BannerKey | 'native' = slot === 'banner300x250' ? 'banner-300x250' : (slot as BannerKey | 'native');

// Determine slot configuration and validity
let isSlotValid = false;
let slotWidth = 300;
let slotHeight = 250;
let slotKey = '';
let nativeContainerId = '';
let nativeScriptUrl = '';

if (isGlobalEnabled) {
  if (normalizedSlot === 'native') {
    const nativeConfig = adConfig.adsterra.nativeBanner;
    slotKey = nativeConfig?.key || '';
    nativeContainerId = nativeConfig?.containerId || '';
    nativeScriptUrl = nativeConfig?.scriptUrl || '';
    // Native renders only if enabled AND key is valid 32-char hex AND containerId is present
    const isKeyValid = Boolean(slotKey && /^[a-f0-9]{32}$/.test(slotKey));
    isSlotValid = Boolean(
      nativeConfig?.enabled &&
      isKeyValid &&
      nativeContainerId &&
      nativeScriptUrl
    );
  } else {
    const banner = adConfig.adsterra.banners?.[normalizedSlot];
    if (banner) {
      slotKey = banner.key || '';
      slotWidth = banner.width;
      slotHeight = banner.height;
      // Banner renders only if enabled AND key is valid 32-char hex
      const isKeyValid = Boolean(slotKey && /^[a-f0-9]{32}$/.test(slotKey));
      isSlotValid = Boolean(
        banner.enabled &&
        isKeyValid
      );
    }
  }
}

const minHeight = normalizedSlot === 'native' ? '160px' : `${slotHeight}px`;
const minWidth = normalizedSlot === 'native' ? '100%' : `${slotWidth}px`;
const uniqueId = `ad-${normalizedSlot}-${Math.random().toString(36).substring(2, 9)}`;
---

{isSlotValid && (
  <aside 
    class={`ad-slot-wrapper ad-slot-${normalizedSlot} ${className}`} 
    aria-label={label}
    id={uniqueId}
    data-slot-type={normalizedSlot}
    data-slot-width={slotWidth}
    data-slot-height={slotHeight}
    data-slot-key={slotKey}
    data-native-script={nativeScriptUrl}
    data-native-container={nativeContainerId}
  >
    <div class="ad-slot-header">
      <span class="ad-slot-tag">{label}</span>
    </div>
    <div 
      class="ad-slot-container"
      style={`min-height: ${minHeight}; min-width: ${minWidth};`}
      id={`box-${uniqueId}`}
    >
      <!-- Self-hosted iframe or native ad dynamically appended on viewport entry -->
    </div>
  </aside>
)}

{isSlotValid && (
  <script is:inline define:vars={{ uniqueId, normalizedSlot, slotWidth, slotHeight, label }}>
    (function () {
      const el = document.getElementById(uniqueId);
      if (!el) return;

      // 1. Googlebot & SEO Crawler Shielding (protects PageSpeed, GSC index & AdSense eligibility)
      const isBot = /bot|googlebot|crawler|spider|mediapartners-google|adsbot-google|google-read-aloud|lighthouse/i.test(navigator.userAgent);
      if (isBot) {
        el.style.display = 'none';
        return;
      }

      const box = document.getElementById('box-' + uniqueId);
      if (!box) return;

      let hasInjected = false;

      function loadAd() {
        if (hasInjected) return;
        hasInjected = true;

        if (normalizedSlot === 'native') {
          try {
            const containerId = el.dataset.nativeContainer;
            if (containerId) {
              const innerContainer = document.createElement('div');
              innerContainer.id = containerId;
              box.appendChild(innerContainer);
            }

            const s = document.createElement('script');
            s.async = true;
            s.setAttribute('data-cfasync', 'false');
            s.src = el.dataset.nativeScript;
            box.appendChild(s);
          } catch (err) {
            console.error('[AdSlot Native Error]', err);
          }
        } else {
          // Self-Hosted Iframe Architecture (/ads/banner-XXX.html)
          try {
            const iframe = document.createElement('iframe');
            iframe.setAttribute('src', '/ads/' + normalizedSlot + '.html');
            iframe.width = String(slotWidth);
            iframe.height = String(slotHeight);
            iframe.scrolling = 'no';
            iframe.frameBorder = '0';
            iframe.title = 'Ad: ' + (label || 'Sponsored Guide Intel');
            iframe.setAttribute('loading', 'lazy');
            iframe.style.border = 'none';
            iframe.style.overflow = 'hidden';
            iframe.style.maxWidth = '100%';
            iframe.style.display = 'block';
            box.appendChild(iframe);
          } catch (err) {
            console.error('[AdSlot Iframe Error]', err);
          }
        }
      }

      // 2. IntersectionObserver Lazy Loading with 800px rootMargin for Zero-CLS & instant delivery
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              observer.disconnect();
              loadAd();
            }
          });
        }, { rootMargin: '800px 0px' });
        observer.observe(el);
      } else {
        loadAd();
      }
    })();
  </script>
)}

<style>
  .ad-slot-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 1.5rem auto;
    padding: 0.75rem 0.85rem;
    background: rgba(18, 20, 22, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    max-width: 100%;
    overflow: hidden;
    position: relative;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .ad-slot-header {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-bottom: 0.4rem;
  }

  .ad-slot-tag {
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted, #7e8790);
    opacity: 0.8;
    user-select: none;
    font-family: 'IBM Plex Mono', monospace;
  }

  .ad-slot-container {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    max-width: 100%;
    width: 100%;
  }

  .ad-slot-banner-728x90 .ad-slot-container {
    width: 728px;
    height: 90px;
  }

  .ad-slot-banner-160x300 .ad-slot-container {
    width: 160px;
    height: 300px;
  }

  .ad-slot-banner-160x600 .ad-slot-container {
    width: 160px;
    height: 600px;
  }

  .ad-slot-banner-320x50 .ad-slot-container {
    width: 320px;
    height: 50px;
  }

  .ad-slot-banner-300x250 .ad-slot-container,
  .ad-slot-banner300x250 .ad-slot-container {
    width: 300px;
    height: 250px;
  }

  .ad-slot-native .ad-slot-container {
    width: 100%;
    min-height: 160px;
  }
</style>
