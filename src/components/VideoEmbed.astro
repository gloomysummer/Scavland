---
export interface Props {
  id: string;
  title: string;
  description?: string;
  uploadDate?: string;
  channelTitle?: string;
  captionLabel?: string;
}

const {
  id,
  title,
  description = "Official Scavland gameplay walkthrough and trailer showcase.",
  uploadDate = "2026-09-04",
  channelTitle = "Scavland (Official Channel)",
  captionLabel = "Official Video Reference"
} = Astro.props;

const embedUrl = `https://www.youtube-nocookie.com/embed/${id}`;
const thumbnailUrl = `https://img.youtube.com/vi/${id}/maxresdefault.jpg`;

const schema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": title,
  "description": description,
  "thumbnailUrl": [thumbnailUrl],
  "uploadDate": uploadDate,
  "embedUrl": embedUrl
};
---

<div class="video-embed-wrapper">
  <!-- 16:9 Zero-CLS Aspect Ratio Container -->
  <div class="video-embed-container">
    <iframe
      class="video-embed-iframe"
      src={embedUrl}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
    ></iframe>
  </div>
  <p class="video-embed-caption">
    {captionLabel}: <span class="video-title">{title}</span> <span class="video-channel">· {channelTitle}</span>
  </p>

  <!-- VideoObject JSON-LD for Google Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</div>

<style>
  .video-embed-wrapper {
    margin: 1.75rem 0;
  }
  .video-embed-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--line, #26362e);
    background: #000;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }
  .video-embed-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-embed-caption {
    font-size: 0.75rem;
    color: var(--muted, #9aa9a0);
    font-family: 'IBM Plex Mono', monospace;
    margin-top: 0.5rem;
    text-align: center;
    line-height: 1.4;
  }
  .video-title {
    color: var(--ink, #e7eee9);
    font-weight: 600;
  }
  .video-channel {
    color: var(--acid, #b9e86c);
  }
</style>
