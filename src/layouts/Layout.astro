---
import '../styles/global.css';
import AdsterraSocialBar from '../components/AdsterraSocialBar.astro';

const { title = 'Scavland Wiki — Guides, Weapons & Database', description = 'The complete Scavland Wiki: evidence-led guides for survival, weapons, loot, quests, factions, maps, and system mechanics.', keywords = 'Scavland, Scavland Wiki, survival RPG, weapons, loot, quests, factions, Mist, crafting, release date, system requirements', canonical = Astro.url.pathname } = Astro.props;
const siteUrl = 'https://scavland.wiki';
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || (path !== '/' && currentPath.startsWith(path));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={`${siteUrl}${canonical}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}${canonical}`} />
    <meta property="og:site_name" content="Scavland Wiki" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${siteUrl}/images/og-scavland.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Scavland Wiki - Complete Game Guides and Database" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/images/og-scavland.jpg`} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/images/icons/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/images/icons/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/icons/apple-touch-icon.png" sizes="192x192" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EFV7HR5LJR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-EFV7HR5LJR');
    </script>
    <slot name="schema" />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header"><a class="brand" href="/"><img src="/images/icons/logo.svg" alt="" width="32" height="32" /><span>SCAVLAND<span class="brand-sub">WIKI &amp; DATABASE</span></span></a><nav aria-label="Primary"><a class:list={{active:isActive('/guide/')}} href="/guide/">Guides</a><a class:list={{active:isActive('/weapons/')}} href="/weapons/">Weapons</a><a class:list={{active:isActive('/factions/')}} href="/factions/">Factions</a><a class:list={{active:isActive('/release-date/')}} href="/release-date/">Release</a><a class:list={{active:isActive('/system-requirements/')}} href="/system-requirements/">Specs</a><a class:list={{active:isActive('/wiki/')}} href="/wiki/">Systems</a><a class:list={{active:isActive('/maps/')}} href="/maps/">World</a><a class:list={{active:isActive('/updates/')}} href="/updates/">Updates</a><a href="/search/" class="nav-search" aria-label="Search guides">Search <kbd>/</kbd></a></nav></header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer"><div><strong>Scavland Wiki &amp; Database</strong><p>Independent community wiki with verified game data and tactical field notes. Not affiliated with NoShadow.</p></div><div class="footer-links"><a href="/release-date/">Release Date</a><a href="/system-requirements/">PC Requirements</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy</a><a href="https://store.steampowered.com/app/3373500/Scavland/" rel="noreferrer">Official Steam</a></div><small>Scavland Wiki Database updated August 2026 · Official Verified Baseline.</small></footer>
    <AdsterraSocialBar />
  </body>
</html>
