---
import '../styles/global.css';
import { adConfig } from '../data/adConfig';
import { supportedLanguages, uiTranslations, getLanguageFromPath, getLocalizedUrl, getLanguageSwitcherUrl, stripLocale, getAvailableLanguages, type Language } from '../data/i18n';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  lang?: Language;
}

const { 
  title = 'Scavland Wiki — Guides, Weapons & Database', 
  description = 'The complete Scavland Wiki: evidence-led guides for survival, weapons, loot, quests, factions, maps, and system mechanics.', 
  keywords = 'Scavland, Scavland Wiki, survival RPG, weapons, loot, quests, factions, Mist, crafting, release date, system requirements', 
  canonical = Astro.url.pathname,
  lang: propLang
} = Astro.props;

const siteUrl = 'https://scavland.wiki';
const currentPath = Astro.url.pathname;
const lang: Language = propLang || getLanguageFromPath(currentPath);
const t = uiTranslations[lang];

const cleanCanonical = stripLocale(canonical);
const availableLangs = getAvailableLanguages(cleanCanonical);
const enUrl = `${siteUrl}${cleanCanonical}`;

const isActive = (path: string) => {
  const locPath = getLocalizedUrl(path, lang);
  return currentPath === locPath || (locPath !== '/' && locPath !== `/${lang}/` && currentPath.startsWith(locPath));
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={`${siteUrl}${canonical}`} />
    
    <!-- Multi-language hreflang SEO cluster for Googlebot (Dynamic & Reciprocal) -->
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    {availableLangs.map((l) => (
      <link rel="alternate" hreflang={l} href={`${siteUrl}${getLocalizedUrl(cleanCanonical, l)}`} />
    ))}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}${canonical}`} />
    <meta property="og:site_name" content="Scavland Wiki" />
    <meta property="og:locale" content={supportedLanguages[lang].locale} />
    <meta property="og:image" content={`${siteUrl}/images/og-scavland.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Scavland Wiki - Complete Game Guides and Database" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/images/og-scavland.jpg`} />
    <!-- Preload critical self-hosted fonts for instant text rendering -->
    <link rel="preload" href="/fonts/BarlowCondensed-700-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <!-- DNS prefetch for third-party scripts to avoid render blocking -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="preconnect" href="https://www.highrevenueformat.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.highrevenueformat.com" />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <!-- Favicon & Icons: Prioritize 48px multiples for Google Favicon bot compliance -->
    <link rel="icon" href="/images/icons/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/images/icons/apple-touch-icon.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/icons/apple-touch-icon.png" sizes="192x192" />
    <link rel="icon" href="/images/icons/logo.svg" type="image/svg+xml" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EFV7HR5LJR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-EFV7HR5LJR');
    </script>
    <!-- Microsoft Clarity Heatmaps & Session Recording -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "yprilwmrna");
    </script>
    <!-- Google AdSense Account Verification & Auto Ads Tag (Required for site review & ads.txt crawler) -->
    {adConfig.adsense.clientId && (
      <meta name="google-adsense-account" content={adConfig.adsense.clientId} />
    )}
    {adConfig.enabled && adConfig.adsense.clientId && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adConfig.adsense.clientId}`} crossorigin="anonymous"></script>
    )}

    <!-- Adsterra Monetization Engine (Popunder & Social Bar - Disabled for pristine UX & AdSense compliance) -->
    {adConfig.enabled && adConfig.provider === 'adsterra' && (adConfig.adsterra.popunderUrl || adConfig.adsterra.socialBarUrl) && (
      <script is:inline define:vars={{ popunderUrl: adConfig.adsterra.popunderUrl, socialBarUrl: adConfig.adsterra.socialBarUrl }}>
        (function() {
          // Crawler & Bot Shielding (Googlebot, Lighthouse, PageSpeed, Mediapartners)
          var isBot = /bot|googlebot|crawler|spider|mediapartners-google|adsbot-google|google-read-aloud|lighthouse/i.test(navigator.userAgent);
          if (isBot) return;

          function initAdsterraGlobals() {
            if (popunderUrl) {
              var p = document.createElement('script');
              p.type = 'text/javascript';
              p.src = popunderUrl;
              p.async = true;
              document.body.appendChild(p);
            }
            if (socialBarUrl) {
              var s = document.createElement('script');
              s.type = 'text/javascript';
              s.src = socialBarUrl;
              s.async = true;
              document.body.appendChild(s);
            }
          }

          // Delay execution by 1.2s to guarantee zero Core Web Vitals (LCP/FID/CLS) penalty
          if (document.readyState === 'complete') {
            setTimeout(initAdsterraGlobals, 1200);
          } else {
            window.addEventListener('load', function() {
              setTimeout(initAdsterraGlobals, 1200);
            });
          }
        })();
      </script>
    )}

    {adConfig.growMe?.enabled && adConfig.growMe.siteId && (
      <script async data-grow-initializer="" define:vars={{ siteId: adConfig.growMe.siteId }}>
        (function(){window.growMe||((window.growMe=function(e){window.growMe._.push(e);}),(window.growMe._=[]));var e=document.createElement("script");e.type="text/javascript",e.src="https://faves.grow.me/main.js",e.defer=!0,e.setAttribute("data-grow-faves-site-id",siteId);var t=document.getElementsByTagName("script")[0];t.parentNode.insertBefore(e,t);})();
      </script>
    )}
    <slot name="schema" />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={getLocalizedUrl('/', lang)}>
        <img src="/images/icons/logo.svg" alt="" width="32" height="32" />
        <span>SCAVLAND<span class="brand-sub">{t.brandSub}</span></span>
      </a>
      <nav aria-label="Primary" class="site-nav">
        <a class:list={{active:isActive('/guide/')}} href={getLocalizedUrl('/guide/', lang)}>{t.nav.guides}</a>
        <a class:list={{active:isActive('/weapons/')}} href={getLocalizedUrl('/weapons/', lang)}>{t.nav.weapons}</a>
        <a class:list={{active:isActive('/factions/')}} href={getLocalizedUrl('/factions/', lang)}>{t.nav.factions}</a>
        <a class:list={{active:isActive('/release-date/')}} href={getLocalizedUrl('/release-date/', lang)}>{t.nav.release}</a>
        <a class:list={{active:isActive('/system-requirements/')}} href={getLocalizedUrl('/system-requirements/', lang)}>{t.nav.specs}</a>
        <a class:list={{active:isActive('/wiki/')}} href={getLocalizedUrl('/wiki/', lang)}>{t.nav.systems}</a>
        <a class:list={{active:isActive('/maps/')}} href={getLocalizedUrl('/maps/', lang)}>{t.nav.world}</a>
        <a class:list={{active:isActive('/updates/')}} href={getLocalizedUrl('/updates/', lang)}>{t.nav.updates}</a>
        <a href={getLocalizedUrl('/search/', lang)} class="nav-search" aria-label="Search guides">{t.nav.search} <kbd>/</kbd></a>
      </nav>
      <!-- Tactical Language Switcher -->
      <div class="lang-switcher" role="navigation" aria-label="Language selector">
        <a href={getLanguageSwitcherUrl(currentPath, 'en')} class:list={['lang-btn', { active: lang === 'en' }]} title="English">EN</a>
        <a href={getLanguageSwitcherUrl(currentPath, 'ru')} class:list={['lang-btn', { active: lang === 'ru' }]} title="Русский">RU</a>
        <a href={getLanguageSwitcherUrl(currentPath, 'de')} class:list={['lang-btn', { active: lang === 'de' }]} title="Deutsch">DE</a>
        <a href={getLanguageSwitcherUrl(currentPath, 'ja')} class:list={['lang-btn', { active: lang === 'ja' }]} title="日本語">JA</a>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="footer-mega-grid">
          <!-- Col 1: Brand & Disclaimer -->
          <div class="footer-col footer-col-brand">
            <a class="footer-brand" href={getLocalizedUrl('/', lang)}>
              <img src="/images/icons/logo.svg" alt="" width="28" height="28" />
              <span>SCAVLAND WIKI</span>
            </a>
            <p class="footer-desc">
              Independent tactical database, anomaly survival strategies, weapon attachment stats, and progression walkthroughs for Scavland.
            </p>
            <p class="footer-disclaimer">
              Fan-made resource, not affiliated with, endorsed, or sponsored by NoShadow. All game assets and trademarks belong to their respective creators.
            </p>
          </div>

          <!-- Col 2: Categories (频道) -->
          <div class="footer-col">
            <h4 class="footer-heading">{lang === 'de' ? 'Kategorien' : lang === 'ja' ? 'カテゴリー' : lang === 'ru' ? 'Категории' : 'Categories'}</h4>
            <ul class="footer-nav-list">
              <li><a href={getLocalizedUrl('/guide/', lang)}>{t.nav.guides}</a></li>
              <li><a href={getLocalizedUrl('/weapons/', lang)}>{t.nav.weapons}</a></li>
              <li><a href={getLocalizedUrl('/factions/', lang)}>{t.nav.factions}</a></li>
              <li><a href={getLocalizedUrl('/maps/', lang)}>{t.nav.world}</a></li>
              <li><a href={getLocalizedUrl('/comparisons/scavland-vs-zero-sievert/', lang)}>Scavland vs Zero Sievert</a></li>
              <li><a href={getLocalizedUrl('/wiki/', lang)}>{t.nav.systems}</a></li>
              <li><a href={getLocalizedUrl('/updates/', lang)}>{t.nav.updates}</a></li>
            </ul>
          </div>

          <!-- Col 3: Featured Guides (重点文章平铺 5-8 篇) -->
          <div class="footer-col">
            <h4 class="footer-heading">{lang === 'de' ? 'Top-Guides' : lang === 'ja' ? '主要ガイド' : lang === 'ru' ? 'Популярные гайды' : 'Featured Guides'}</h4>
            <ul class="footer-nav-list">
              <li><a href={getLocalizedUrl('/guide/scavland-beginner-guide/', lang)}>Beginner Survival Guide</a></li>
              <li><a href={getLocalizedUrl('/guide/scavland-weapons-and-attachments/', lang)}>Weapons &amp; Attachments</a></li>
              <li><a href={getLocalizedUrl('/guide/scavland-mist-survival-and-radiation/', lang)}>Mist Survival &amp; Radiation</a></li>
              <li><a href={getLocalizedUrl('/guide/scavland-death-and-loot-recovery/', lang)}>Death &amp; Loot Recovery</a></li>
              <li><a href={getLocalizedUrl('/guide/scavland-factions-and-reputation/', lang)}>Factions &amp; Reputation</a></li>
              <li><a href={getLocalizedUrl('/guide/scavland-steam-deck-and-handheld-settings/', lang)}>Steam Deck &amp; Handheld Settings</a></li>
              <li><a href={getLocalizedUrl('/guide/scavland-price-and-regional-editions/', lang)}>Price &amp; Regional Editions</a></li>
            </ul>
          </div>

          <!-- Col 4: Resources & Community -->
          <div class="footer-col">
            <h4 class="footer-heading">{lang === 'de' ? 'Ressourcen' : lang === 'ja' ? 'リソース' : lang === 'ru' ? 'Ресурсы' : 'Resources'}</h4>
            <ul class="footer-nav-list">
              <li><a href={getLocalizedUrl('/release-date/', lang)}>{t.nav.release}</a></li>
              <li><a href={getLocalizedUrl('/system-requirements/', lang)}>{t.nav.specs}</a></li>
              <li><a href="/about/">About</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy-policy/">Privacy Policy</a></li>
              <li><a href="/terms/">Terms of Service</a></li>
              <li><a href="/sitemap-index.xml">XML Sitemap</a></li>
            </ul>
            <h4 class="footer-heading" style="margin-top:20px;">Official Community</h4>
            <ul class="footer-nav-list community-links">
              <li><a href="https://store.steampowered.com/app/3373500/Scavland/" target="_blank" rel="noopener noreferrer">Steam Store Hub ↗</a></li>
              <li><a href="https://store.steampowered.com/news/app/3373500" target="_blank" rel="noopener noreferrer">Steam Announcements ↗</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom-bar">
          <small>© {new Date().getFullYear()} Scavland Wiki &amp; Database · {t.common.footerUpdated}</small>
          <div class="footer-bottom-links">
            <a href={getLocalizedUrl('/guide/', lang)}>{t.nav.guides}</a>
            <span>·</span>
            <a href="/privacy-policy/">Privacy</a>
            <span>·</span>
            <a href="/contact/">Contact</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
