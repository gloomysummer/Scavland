---
import '../styles/global.css';
import { adConfig } from '../data/adConfig';
import { supportedLanguages, uiTranslations, getLanguageFromPath, getLocalizedUrl, stripLocale, isMultiLangPath, type Language } from '../data/i18n';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  lang?: Language;
}

const { 
  title = 'Scavland Wiki — Guides, Weapons & Database', 
  description = 'The complete Scavland Wiki: evidence-led guides for survival, weapons, loot, quests, factions, maps, and system mechanics.', 
  keywords = 'Scavland, Scavland Wiki, survival RPG, weapons, loot, quests, factions, Mist, crafting, release date, system requirements', 
  canonical = Astro.url.pathname,
  lang: propLang
} = Astro.props;

const siteUrl = 'https://scavland.wiki';
const currentPath = Astro.url.pathname;
const lang: Language = propLang || getLanguageFromPath(currentPath);
const t = uiTranslations[lang];

const cleanCanonical = stripLocale(canonical);
const isMultiLang = isMultiLangPath(cleanCanonical);
const enUrl = `${siteUrl}${getLocalizedUrl(cleanCanonical, 'en')}`;
const ruUrl = `${siteUrl}${getLocalizedUrl(cleanCanonical, 'ru')}`;
const deUrl = `${siteUrl}${getLocalizedUrl(cleanCanonical, 'de')}`;
const jaUrl = `${siteUrl}${getLocalizedUrl(cleanCanonical, 'ja')}`;

const isActive = (path: string) => {
  const locPath = getLocalizedUrl(path, lang);
  return currentPath === locPath || (locPath !== '/' && locPath !== `/${lang}/` && currentPath.startsWith(locPath));
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={`${siteUrl}${canonical}`} />
    
    <!-- Multi-language hreflang SEO cluster for Googlebot (Defensive against 404 targets) -->
    {isMultiLang ? (
      <>
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="ru" href={ruUrl} />
        <link rel="alternate" hreflang="de" href={deUrl} />
        <link rel="alternate" hreflang="ja" href={jaUrl} />
        <link rel="alternate" hreflang="x-default" href={enUrl} />
      </>
    ) : (
      <>
        <link rel="alternate" hreflang="x-default" href={enUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
      </>
    )}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}${canonical}`} />
    <meta property="og:site_name" content="Scavland Wiki" />
    <meta property="og:locale" content={supportedLanguages[lang].locale} />
    <meta property="og:image" content={`${siteUrl}/images/og-scavland.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Scavland Wiki - Complete Game Guides and Database" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/images/og-scavland.jpg`} />
    <!-- Preload critical self-hosted fonts for instant text rendering -->
    <link rel="preload" href="/fonts/BarlowCondensed-700-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <!-- DNS prefetch for third-party scripts to avoid render blocking -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <!-- Favicon & Icons: Prioritize 48px multiples for Google Favicon bot compliance -->
    <link rel="icon" href="/images/icons/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/images/icons/apple-touch-icon.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/icons/apple-touch-icon.png" sizes="192x192" />
    <link rel="icon" href="/images/icons/logo.svg" type="image/svg+xml" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EFV7HR5LJR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-EFV7HR5LJR');
    </script>
    {adConfig.enabled && adConfig.adsense.autoAds && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adConfig.adsense.clientId}`} crossorigin="anonymous"></script>
    )}
    {adConfig.growMe?.enabled && adConfig.growMe.siteId && (
      <script async data-grow-initializer="" define:vars={{ siteId: adConfig.growMe.siteId }}>
        (function(){window.growMe||((window.growMe=function(e){window.growMe._.push(e);}),(window.growMe._=[]));var e=document.createElement("script");e.type="text/javascript",e.src="https://faves.grow.me/main.js",e.defer=!0,e.setAttribute("data-grow-faves-site-id",siteId);var t=document.getElementsByTagName("script")[0];t.parentNode.insertBefore(e,t);})();
      </script>
    )}
    <slot name="schema" />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={getLocalizedUrl('/', lang)}>
        <img src="/images/icons/logo.svg" alt="" width="32" height="32" />
        <span>SCAVLAND<span class="brand-sub">{t.brandSub}</span></span>
      </a>
      <nav aria-label="Primary">
        <a class:list={{active:isActive('/guide/')}} href={getLocalizedUrl('/guide/', lang)}>{t.nav.guides}</a>
        <a class:list={{active:isActive('/weapons/')}} href={getLocalizedUrl('/weapons/', lang)}>{t.nav.weapons}</a>
        <a class:list={{active:isActive('/factions/')}} href={getLocalizedUrl('/factions/', lang)}>{t.nav.factions}</a>
        <a class:list={{active:isActive('/release-date/')}} href={getLocalizedUrl('/release-date/', lang)}>{t.nav.release}</a>
        <a class:list={{active:isActive('/system-requirements/')}} href={getLocalizedUrl('/system-requirements/', lang)}>{t.nav.specs}</a>
        <a class:list={{active:isActive('/wiki/')}} href={getLocalizedUrl('/wiki/', lang)}>{t.nav.systems}</a>
        <a class:list={{active:isActive('/maps/')}} href={getLocalizedUrl('/maps/', lang)}>{t.nav.world}</a>
        <a class:list={{active:isActive('/updates/')}} href={getLocalizedUrl('/updates/', lang)}>{t.nav.updates}</a>
        <a href={getLocalizedUrl('/search/', lang)} class="nav-search" aria-label="Search guides">{t.nav.search} <kbd>/</kbd></a>
        
        <!-- Tactical Language Switcher -->
        <div class="lang-switcher" aria-label="Change Language">
          <a href={getLocalizedUrl(currentPath, 'en')} class:list={['lang-btn', { active: lang === 'en' }]} title="English">EN</a>
          {isMultiLang ? (
            <>
              <a href={getLocalizedUrl(currentPath, 'ru')} class:list={['lang-btn', { active: lang === 'ru' }]} title="Русский">RU</a>
              <a href={getLocalizedUrl(currentPath, 'de')} class:list={['lang-btn', { active: lang === 'de' }]} title="Deutsch">DE</a>
              <a href={getLocalizedUrl(currentPath, 'ja')} class:list={['lang-btn', { active: lang === 'ja' }]} title="日本語">JA</a>
            </>
          ) : (
            <>
              <span class="lang-btn disabled" title="Russian translation available for Home & Guides only" style="opacity:0.35;cursor:not-allowed;font-size:0.75rem;padding:2px 6px;">RU</span>
              <span class="lang-btn disabled" title="German translation available for Home & Guides only" style="opacity:0.35;cursor:not-allowed;font-size:0.75rem;padding:2px 6px;">DE</span>
              <span class="lang-btn disabled" title="Japanese translation available for Home & Guides only" style="opacity:0.35;cursor:not-allowed;font-size:0.75rem;padding:2px 6px;">JA</span>
            </>
          )}
        </div>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div>
        <strong>Scavland Wiki &amp; Database</strong>
        <p>{t.common.footerDisclaimer}</p>
      </div>
      <div class="footer-links">
        <a href={getLocalizedUrl('/release-date/', lang)}>{t.nav.release}</a>
        <a href={getLocalizedUrl('/system-requirements/', lang)}>{t.nav.specs}</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy-policy/">Privacy</a>
        <a href="https://store.steampowered.com/app/3373500/Scavland/" rel="noreferrer">{t.common.officialSteam}</a>
      </div>
      <small>{t.common.footerUpdated}</small>
    </footer>
  </body>
</html>
